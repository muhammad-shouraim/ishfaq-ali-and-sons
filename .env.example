# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MySQL Database (Hostinger MySQL) ─────────────────────
# Get these from Hostinger hPanel → MySQL Databases
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ishfaqaliandsons
MYSQL_USER=root
MYSQL_PASSWORD=

# ─── JWT Authentication ───────────────────────────────────
# Change this to a random secure string in production
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRE=7d

# ─── Cloudinary (Product Images) ──────────────────────────
# Get these from https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Nodemailer) ───────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@ishfaqaliandsons.com

# ─── Site Configuration ───────────────────────────────────
SITE_NAME=ISHFAQ ALI & SONS
SITE_URL=http://localhost:5000
CONTACT_EMAIL=ishfaqaliandsons123@gmail.com
CONTACT_PHONE=+92 332 9940666
WHATSAPP_NUMBER=+923329940666

# ─── Google OAuth ─────────────────────────────────────────
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── CORS ─────────────────────────────────────────────────
# Set to your frontend domain in production (e.g., https://yourdomain.com)
CORS_ORIGIN=*

# ─── Admin Panel ───────────────────────────────────────────
# Change this to a hard-to-guess path for security
ADMIN_PANEL_PATH=/ishfaq-control-panel-x7k9
