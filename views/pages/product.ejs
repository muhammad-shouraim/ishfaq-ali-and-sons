<%- include('../partials/header') %>
<% if (typeof product !== 'undefined' && product) { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "<%= product.name.replace(/"/g, '\\"') %>",
  "description": "<%= (product.shortDescription || product.description || '').replace(/"/g, '\\"').substring(0, 200) %>",
  "sku": "<%= product.sku || '' %>",
  "brand": { "@type": "Brand", "name": "ISHFAQ ALI & SONS" },
  "offers": {
    "@type": "Offer",
    "price": "<%= product.price %>",
    "priceCurrency": "PKR",
    "availability": "<%= product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock' %>"
  }
}
</script>
<% } %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">Product Details</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <a href="/shop">Shop</a> <span>/</span> <span><%= product ? product.name : 'Product' %></span>
      </div>
    </div>
  </section>

  <section class="section product-detail-section">
    <div class="container">
      <% if (product) { %>
      <div class="product-detail" data-aos="fade-up">
        <div class="product-gallery">
          <% var prodImages = typeof product.images === 'string' ? JSON.parse(product.images || '[]') : (product.images || []); %>
          <% var galleryImages = []; if (product.thumbnail) galleryImages.push(product.thumbnail); prodImages.forEach(function(i) { if (galleryImages.indexOf(i) === -1) galleryImages.push(i); }); if (galleryImages.length === 0) galleryImages.push('/images/newlogo.png'); %>
          <div class="product-main-image" id="mainImageContainer">
            <img src="<%= galleryImages[0] %>" alt="<%= product.name %>" id="mainProductImage" onerror="this.onerror=null;this.src='/images/newlogo.png'">
            <button class="img-zoom-btn" id="zoomBtn" aria-label="Zoom"><i class="fas fa-search-plus"></i></button>
            <% if (galleryImages.length > 1) { %>
            <button class="gallery-arrow gallery-prev" id="galleryPrev"><i class="fas fa-chevron-left"></i></button>
            <button class="gallery-arrow gallery-next" id="galleryNext"><i class="fas fa-chevron-right"></i></button>
            <% } %>
          </div>
          <% if (galleryImages.length > 1) { %>
          <div class="product-thumbnails">
            <% galleryImages.forEach(function(img, idx) { %>
            <div class="thumb-item <%= idx === 0 ? 'active' : '' %>" data-img="<%= img %>">
              <img src="<%= img %>" alt="<%= product.name %>" onerror="this.parentElement.style.display='none'">
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>
        <div class="product-info">
          <div class="product-badges">
            <% if (product.isNewArrival) { %><span class="badge badge-new">New</span><% } %>
            <% if (product.comparePrice > product.price) { %><span class="badge badge-sale">Sale</span><% } %>
          </div>
          <h1 class="product-title"><%= product.name %></h1>
          <div class="product-price">
            <span class="current-price"><%= currencySymbol %> <%= Number(product.price).toLocaleString() %></span>
            <% if (product.comparePrice > product.price) { %>
            <span class="compare-price"><%= currencySymbol %> <%= Number(product.comparePrice).toLocaleString() %></span>
            <% } %>
          </div>
          <p class="product-description"><%= product.shortDescription || product.description %></p>
          <div class="product-actions">
            <div class="quantity-selector">
              <button class="qty-btn" id="qtyMinus">-</button>
              <input type="number" id="qtyInput" value="1" min="1" readonly>
              <button class="qty-btn" id="qtyPlus">+</button>
            </div>
            <button class="btn btn-gold add-to-cart-btn" data-product-id="<%= product.id %>" style="flex:1">
              <i class="fas fa-shopping-bag"></i> Add to Bag
            </button>
            <button class="btn btn-outline quick-buy-btn" data-product-id="<%= product.id %>" style="padding:12px 16px;font-size:0.72rem;white-space:nowrap">
              <i class="fas fa-bolt"></i> Quick Buy
            </button>
            <button class="action-btn wishlist-toggle" data-product-id="<%= product.id %>">
              <i class="far fa-heart"></i>
            </button>
          </div>
          <div class="product-meta">
            <% if (product.categoryData) { %>
            <div class="meta-item"><strong>Category:</strong> <a href="/collection/<%= product.categoryData.slug %>"><%= product.categoryData.name %></a></div>
            <% } %>
            <% if (product.sku) { %><div class="meta-item"><strong>SKU:</strong> <%= product.sku %></div><% } %>
            <% if (product.material) { %><div class="meta-item"><strong>Material:</strong> <%= product.material %></div><% } %>
            <% if (product.weight) { %><div class="meta-item"><strong>Weight:</strong> <%= product.weight %></div><% } %>
            <div class="meta-item"><strong>Availability:</strong> <span class="in-stock"><%= product.stock > 0 ? 'In Stock' : 'Out of Stock' %></span></div>
          </div>
          <div class="product-share">
            <span>Share:</span>
            <a href="#" onclick="window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(window.location.href),'_blank')"><i class="fab fa-facebook-f"></i></a>
            <a href="#" onclick="window.open('https://wa.me/?text='+encodeURIComponent(window.location.href),'_blank')"><i class="fab fa-whatsapp"></i></a>
            <a href="#" onclick="window.open('https://twitter.com/intent/tweet?url='+encodeURIComponent(window.location.href),'_blank')"><i class="fab fa-twitter"></i></a>
          </div>
        </div>
      </div>

        <div class="product-tabs" data-aos="fade-up">
        <div class="tabs-header">
          <% if (product.description) { %><button class="tab-btn active" data-tab="description">Description</button><% } %>
          <button class="tab-btn <%= !product.description ? 'active' : '' %>" data-tab="specifications">Specifications</button>
          <button class="tab-btn" data-tab="reviews">Reviews</button>
        </div>
        <div class="tab-content <%= product.description ? 'active' : '' %>" id="tab-description">
          <p><%= product.description %></p>
        </div>
        <div class="tab-content <%= !product.description ? 'active' : '' %>" id="tab-specifications">
          <% if (product.specifications && product.specifications.length) { %>
          <table class="specs-table">
            <% product.specifications.forEach(function(spec) { %>
            <tr><td><%= spec.label %></td><td><%= spec.value %></td></tr>
            <% }) %>
          </table>
          <% } else { %>
          <p>Specifications not yet added.</p>
          <% } %>
        </div>
        <div class="tab-content" id="tab-reviews">
          <div class="reviews-summary">
            <div class="reviews-avg">
              <span class="reviews-avg-number"><%= reviewAvg %></span>
              <div class="stars-display" data-rating="<%= Math.round(reviewAvg) %>"></div>
              <span class="reviews-count">(<%= reviewTotal %> <%= reviewTotal === 1 ? 'review' : 'reviews' %>)</span>
            </div>
          </div>
          <div class="reviews-list" id="reviewsList">
            <% if (reviews && reviews.length > 0) { %>
              <% reviews.forEach(function(r) { %>
              <div class="review-item">
                <div class="review-header">
                  <div class="reviewer-info">
                    <strong><%= r.name %></strong>
                    <div class="stars-display" data-rating="<%= r.rating %>"></div>
                  </div>
                  <span class="review-date"><%= new Date(r.createdAt).toLocaleDateString() %></span>
                </div>
                <% if (r.title) { %><h4 class="review-title"><%= r.title %></h4><% } %>
                <p class="review-comment"><%= r.comment %></p>
              </div>
              <% }) %>
            <% } else { %>
              <p class="reviews-empty">No reviews yet. Be the first to review!</p>
            <% } %>
          </div>
          <div class="review-form-wrap">
            <button class="btn btn-outline" id="showReviewFormBtn"><i class="far fa-star"></i> Write a Review</button>
            <form id="reviewForm" class="review-form" style="display:none" data-product-id="<%= product.id %>">
              <h4>Write Your Review</h4>
              <div class="form-group">
                <label for="reviewName">Your Name</label>
                <input type="text" id="reviewName" name="name" required placeholder="Enter your name">
              </div>
              <div class="form-group">
                <label for="reviewRating">Rating</label>
                <div class="star-rating" id="starRating">
                  <i class="far fa-star" data-value="1"></i>
                  <i class="far fa-star" data-value="2"></i>
                  <i class="far fa-star" data-value="3"></i>
                  <i class="far fa-star" data-value="4"></i>
                  <i class="far fa-star" data-value="5"></i>
                </div>
                <input type="hidden" name="rating" id="reviewRatingValue" value="0">
              </div>
              <div class="form-group">
                <label for="reviewComment">Your Review</label>
                <textarea id="reviewComment" name="comment" rows="4" required placeholder="Share your experience with this product"></textarea>
              </div>
              <button type="submit" class="btn btn-gold">Submit Review</button>
            </form>
          </div>
        </div>
      </div>

      <% if (related && related.length) { %>
      <section class="related-products" data-aos="fade-up">
        <h2>You May <span>Also Like</span></h2>
        <div class="products-grid">
          <% related.forEach(function(item) { %>
          <% var relImages = typeof item.images === 'string' ? (item.images ? JSON.parse(item.images) : []) : (item.images || []); %>
          <% var relImg = item.thumbnail || (relImages.length > 0 ? relImages[0] : '/images/newlogo.png'); %>
          <% var relHover = relImages.length > 0 ? relImages[0] : relImg; %>
          <div class="product-card">
            <div class="product-card-image">
              <a href="/product/<%= item.slug %>">
                <img class="main-img" src="<%= relImg %>" alt="<%= item.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
                <img class="hover-img" src="<%= relHover %>" alt="<%= item.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
              </a>
              <% if (item.comparePrice > 0) { %><span class="badge badge-sale">Sale</span><% } %>
              <button class="wishlist-toggle-sm" data-product-id="<%= item.id %>"><i class="far fa-heart"></i></button>
            </div>
            <div class="product-card-body">
              <h3><a href="/product/<%= item.slug %>"><%= item.name %></a></h3>
              <% if (item.comparePrice > 0) { %>
                <span class="price old-price"><%= currencySymbol %> <%= Number(item.price).toLocaleString() %></span>
                <span class="price sale-price"><%= currencySymbol %> <%= Number(item.comparePrice).toLocaleString() %></span>
              <% } else { %>
                <span class="price"><%= currencySymbol %> <%= Number(item.price).toLocaleString() %></span>
              <% } %>
              <button class="btn btn-sm btn-gold add-to-cart-btn" data-product-id="<%= item.id %>">Add to Bag</button>
            </div>
          </div>
          <% }) %>
        </div>
      </section>
      <% } %>
      <% } else { %>
      <div class="empty-collection">
        <i class="fas fa-gem"></i>
        <h3>Product Not Available</h3>
        <p>This product has not been added yet. Check back soon.</p>
        <a href="/shop" class="btn btn-gold">Browse Shop</a>
      </div>
      <% } %>
    </div>
  </section>
</main>

<div class="img-lightbox" id="imgLightbox">
  <div class="img-lightbox-overlay" id="imgLightboxOverlay"></div>
  <button class="img-lightbox-close" id="imgLightboxClose"><i class="fas fa-times"></i></button>
  <button class="img-lightbox-nav img-lightbox-prev" id="imgLightboxPrev"><i class="fas fa-chevron-left"></i></button>
  <button class="img-lightbox-nav img-lightbox-next" id="imgLightboxNext"><i class="fas fa-chevron-right"></i></button>
  <div class="img-lightbox-content">
    <img src="" alt="" id="imgLightboxImg">
  </div>
  <div class="img-lightbox-counter" id="imgLightboxCounter"></div>
</div>

<script>
// Gallery navigation
(function() {
  var mainImg = document.getElementById('mainProductImage');
  var thumbs = document.querySelectorAll('.thumb-item');
  var prevArrow = document.getElementById('galleryPrev');
  var nextArrow = document.getElementById('galleryNext');
  var zoomBtn = document.getElementById('zoomBtn');

  var images = [];
  thumbs.forEach(function(t) { images.push(t.getAttribute('data-img')); });
  var currentIdx = 0;

  function showImage(idx) {
    if (!images.length || !mainImg) return;
    currentIdx = (idx + images.length) % images.length;
    mainImg.src = images[currentIdx];
    thumbs.forEach(function(t, i) { t.classList.toggle('active', i === currentIdx); });
  }

  // Thumbnail hover/click
  thumbs.forEach(function(t, i) {
    t.addEventListener('mouseenter', function() { showImage(i); });
    t.addEventListener('click', function() { showImage(i); });
  });

  // Arrow navigation
  if (prevArrow) prevArrow.addEventListener('click', function(e) { e.stopPropagation(); showImage(currentIdx - 1); });
  if (nextArrow) nextArrow.addEventListener('click', function(e) { e.stopPropagation(); showImage(currentIdx + 1); });

  // Keyboard
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft' && images.length > 1) showImage(currentIdx - 1);
    if (e.key === 'ArrowRight' && images.length > 1) showImage(currentIdx + 1);
  });

  // Lightbox
  var lightbox = document.getElementById('imgLightbox');
  var lbOverlay = document.getElementById('imgLightboxOverlay');
  var lbClose = document.getElementById('imgLightboxClose');
  var lbImg = document.getElementById('imgLightboxImg');
  var lbPrev = document.getElementById('imgLightboxPrev');
  var lbNext = document.getElementById('imgLightboxNext');
  var lbCounter = document.getElementById('imgLightboxCounter');

  function openLightbox(idx) {
    if (!images.length) return;
    currentIdx = (idx + images.length) % images.length;
    lbImg.src = images[currentIdx];
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
    if (lbCounter && images.length > 1) lbCounter.textContent = (currentIdx + 1) + ' / ' + images.length;
    else if (lbCounter) lbCounter.textContent = '';
  }

  function closeLightbox() { lightbox.classList.remove('active'); document.body.style.overflow = ''; }

  function lbPrevImage() { currentIdx = (currentIdx - 1 + images.length) % images.length; lbImg.src = images[currentIdx]; if (lbCounter && images.length > 1) lbCounter.textContent = (currentIdx + 1) + ' / ' + images.length; }
  function lbNextImage() { currentIdx = (currentIdx + 1) % images.length; lbImg.src = images[currentIdx]; if (lbCounter && images.length > 1) lbCounter.textContent = (currentIdx + 1) + ' / ' + images.length; }

  if (zoomBtn) zoomBtn.addEventListener('click', function(e) { e.stopPropagation(); openLightbox(currentIdx); });
  if (mainImg) mainImg.addEventListener('click', function() { openLightbox(currentIdx); });
  if (lbClose) lbClose.addEventListener('click', closeLightbox);
  if (lbOverlay) lbOverlay.addEventListener('click', closeLightbox);
  if (lbPrev) lbPrev.addEventListener('click', lbPrevImage);
  if (lbNext) lbNext.addEventListener('click', lbNextImage);
  document.addEventListener('keydown', function(e) {
    if (!lightbox || !lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') lbPrevImage();
    if (e.key === 'ArrowRight') lbNextImage();
  });
})();

// Tab switching
document.querySelectorAll('.tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var tab = this.getAttribute('data-tab');
    document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
    document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });
    this.classList.add('active');
    document.getElementById('tab-' + tab).classList.add('active');
  });
});

// Quick Buy
document.querySelectorAll('.quick-buy-btn').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    var productId = this.getAttribute('data-product-id');
    var qtyInput = this.closest('.product-actions')?.querySelector('.quantity-selector input');
    var quantity = qtyInput ? parseInt(qtyInput.value) || 1 : 1;
    var btn = this;
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    try {
      var res = await fetch('/api/cart/add', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId: Number(productId), quantity })
      });
      var data = await res.json();
      if (data.success) {
        window.location.href = '/checkout';
      } else {
        window.showToast(data.message || 'Error', 'error');
      }
    } catch(e) {
      window.showToast('Connection error', 'error');
    }
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-bolt"></i> Quick Buy';
  });
});

// Image Zoom on Hover
(function() {
  var container = document.getElementById('mainImageContainer');
  var img = document.getElementById('mainProductImage');
  if (!container || !img || window.innerWidth <= 1024) return;
  var lens = document.createElement('div');
  lens.className = 'img-zoom-lens';
  var result = document.createElement('div');
  result.className = 'img-zoom-result';
  container.appendChild(lens);
  container.appendChild(result);
  container.addEventListener('mousemove', function(e) {
    e.preventDefault();
    var rect = container.getBoundingClientRect();
    var x = e.clientX - rect.left - lens.offsetWidth / 2;
    var y = e.clientY - rect.top - lens.offsetHeight / 2;
    if (x > container.offsetWidth - lens.offsetWidth) x = container.offsetWidth - lens.offsetWidth;
    if (x < 0) x = 0;
    if (y > container.offsetHeight - lens.offsetHeight) y = container.offsetHeight - lens.offsetHeight;
    if (y < 0) y = 0;
    lens.style.left = x + 'px';
    lens.style.top = y + 'px';
    lens.style.display = 'block';
    result.style.display = 'block';
    var cx = result.offsetWidth / lens.offsetWidth;
    var cy = result.offsetHeight / lens.offsetHeight;
    result.style.backgroundImage = 'url(' + img.src + ')';
    result.style.backgroundSize = (container.offsetWidth * cx) + 'px ' + (container.offsetHeight * cy) + 'px';
    result.style.backgroundPosition = (-x * cx) + 'px ' + (-y * cy) + 'px';
  });
  container.addEventListener('mouseleave', function() {
    lens.style.display = 'none';
    result.style.display = 'none';
  });
})();

// Reviews - star rating
(function() {
  var stars = document.querySelectorAll('#starRating i');
  var ratingInput = document.getElementById('reviewRatingValue');
  if (!stars.length || !ratingInput) return;
  stars.forEach(function(star) {
    star.addEventListener('click', function() {
      var val = parseInt(this.getAttribute('data-value'));
      ratingInput.value = val;
      stars.forEach(function(s) {
        var sv = parseInt(s.getAttribute('data-value'));
        if (sv <= val) {
          s.className = 'fas fa-star active';
        } else {
          s.className = 'far fa-star';
        }
      });
    });
    star.addEventListener('mouseenter', function() {
      var val = parseInt(this.getAttribute('data-value'));
      stars.forEach(function(s) {
        var sv = parseInt(s.getAttribute('data-value'));
        s.className = sv <= val ? 'fas fa-star active' : 'far fa-star';
      });
    });
    star.addEventListener('mouseleave', function() {
      var selected = parseInt(ratingInput.value);
      stars.forEach(function(s) {
        var sv = parseInt(s.getAttribute('data-value'));
        if (selected > 0) {
          s.className = sv <= selected ? 'fas fa-star active' : 'far fa-star';
        } else {
          s.className = 'far fa-star';
        }
      });
    });
  });

  // Display stars for existing reviews
  document.querySelectorAll('.stars-display').forEach(function(el) {
    var rating = parseInt(el.getAttribute('data-rating'));
    if (!rating) return;
    var html = '';
    for (var i = 1; i <= 5; i++) {
      html += i <= rating ? '<i class="fas fa-star"></i>' : '<i class="far fa-star"></i>';
    }
    el.innerHTML = html;
  });
})();

// Review form toggle
var showFormBtn = document.getElementById('showReviewFormBtn');
var reviewForm = document.getElementById('reviewForm');
if (showFormBtn && reviewForm) {
  showFormBtn.addEventListener('click', function() {
    reviewForm.style.display = reviewForm.style.display === 'none' ? 'block' : 'none';
  });
}

// Review form submit
var reviewFormEl = document.getElementById('reviewForm');
if (reviewFormEl) {
  reviewFormEl.addEventListener('submit', async function(e) {
    e.preventDefault();
    var btn = this.querySelector('button[type="submit"]');
    var productId = this.getAttribute('data-product-id');
    var name = document.getElementById('reviewName').value.trim();
    var rating = document.getElementById('reviewRatingValue').value;
    var comment = document.getElementById('reviewComment').value.trim();
    if (!name || rating === '0' || !comment) {
      window.showToast('Please fill in all fields and select a rating', 'error');
      return;
    }
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
    try {
      var res = await fetch('/api/products/' + productId + '/reviews', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ name: name, rating: rating, comment: comment })
      });
      var data = await res.json();
      if (data.success) {
        window.showToast('Review submitted!', 'success');
        this.style.display = 'none';
        document.getElementById('reviewName').value = '';
        document.getElementById('reviewRatingValue').value = '0';
        document.getElementById('reviewComment').value = '';
        document.querySelectorAll('#starRating i').forEach(function(s) { s.className = 'far fa-star'; });
        // Reload reviews
        var reviewsRes = await fetch('/api/products/' + productId + '/reviews');
        var reviewsData = await reviewsRes.json();
        var list = document.getElementById('reviewsList');
        if (reviewsData.reviews && reviewsData.reviews.length > 0) {
          list.innerHTML = reviewsData.reviews.map(function(r) {
            var starsHtml = '';
            for (var i = 1; i <= 5; i++) {
              starsHtml += i <= r.rating ? '<i class="fas fa-star"></i>' : '<i class="far fa-star"></i>';
            }
            var date = new Date(r.createdAt).toLocaleDateString();
            var titleHtml = r.title ? '<h4 class="review-title">' + r.title + '</h4>' : '';
            return '<div class="review-item"><div class="review-header"><div class="reviewer-info"><strong>' + r.name + '</strong><div class="stars-display">' + starsHtml + '</div></div><span class="review-date">' + date + '</span></div>' + titleHtml + '<p class="review-comment">' + r.comment + '</p></div>';
          }).join('');
        } else {
          list.innerHTML = '<p class="reviews-empty">No reviews yet. Be the first to review!</p>';
        }
        // Update summary
        var summaryEl = document.querySelector('.reviews-avg-number');
        var countEl = document.querySelector('.reviews-count');
        if (summaryEl) summaryEl.textContent = reviewsData.avgRating;
        if (countEl) countEl.textContent = '(' + reviewsData.total + ' ' + (reviewsData.total === 1 ? 'review' : 'reviews') + ')';
      } else {
        window.showToast(data.message || 'Failed to submit review', 'error');
      }
    } catch(err) {
      window.showToast('Connection error', 'error');
    }
    btn.disabled = false; btn.textContent = 'Submit Review';
  });
}
</script>

<%- include('../partials/footer') %>