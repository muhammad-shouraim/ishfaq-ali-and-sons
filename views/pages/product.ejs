<%- include('../partials/header') %>
<% if (typeof product !== 'undefined' && product) { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "<%= product.name.replace(/"/g, '\\"') %>",
  "description": "<%= (product.shortDescription || product.description || '').replace(/"/g, '\\"').substring(0, 200) %>",
  "sku": "<%= product.sku || '' %>",
  "brand": { "@type": "Brand", "name": "ISHFAQ ALI & SONS" },
  "offers": {
    "@type": "Offer",
    "price": "<%= product.price %>",
    "priceCurrency": "PKR",
    "availability": "<%= product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock' %>"
  }
}
</script>
<% } %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">Product Details</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <a href="/shop">Shop</a> <span>/</span> <span><%= product ? product.name : 'Product' %></span>
      </div>
    </div>
  </section>

  <section class="section product-detail-section">
    <div class="container">
      <% if (product) { %>
      <div class="product-detail" data-aos="fade-up">
        <div class="product-gallery">
          <div class="product-main-image" id="mainImageContainer">
            <% var prodImages = typeof product.images === 'string' ? JSON.parse(product.images || '[]') : (product.images || []); %>
            <% var mainImg = product.thumbnail || (prodImages.length > 0 ? prodImages[0] : '/images/newlogo.png'); %>
            <img src="<%= mainImg %>" alt="<%= product.name %>" id="mainProductImage">
            <button class="img-zoom-btn" id="zoomBtn" aria-label="Zoom"><i class="fas fa-search-plus"></i></button>
          </div>
          <% if (prodImages.length > 1) { %>
          <div class="product-thumbnails">
            <% prodImages.forEach(function(img, idx) { %>
            <div class="thumb-item <%= idx === 0 ? 'active' : '' %>" data-img="<%= img %>">
              <img src="<%= img %>" alt="<%= product.name %>">
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>
        <div class="product-info">
          <div class="product-badges">
            <% if (product.isNewArrival) { %><span class="badge badge-new">New</span><% } %>
            <% if (product.comparePrice > product.price) { %><span class="badge badge-sale">Sale</span><% } %>
          </div>
          <h1 class="product-title"><%= product.name %></h1>
          <div class="product-price">
            <span class="current-price"><%= currencySymbol %> <%= Number(product.price).toLocaleString() %></span>
            <% if (product.comparePrice > product.price) { %>
            <span class="compare-price"><%= currencySymbol %> <%= Number(product.comparePrice).toLocaleString() %></span>
            <% } %>
          </div>
          <p class="product-description"><%= product.shortDescription || product.description %></p>
          <div class="product-actions">
            <div class="quantity-selector">
              <button class="qty-btn" id="qtyMinus">-</button>
              <input type="number" id="qtyInput" value="1" min="1" readonly>
              <button class="qty-btn" id="qtyPlus">+</button>
            </div>
            <button class="btn btn-gold add-to-cart-btn" data-product-id="<%= product.id %>" style="flex:1">
              <i class="fas fa-shopping-bag"></i> Add to Bag
            </button>
            <button class="btn btn-outline quick-buy-btn" data-product-id="<%= product.id %>" style="padding:12px 16px;font-size:0.72rem;white-space:nowrap">
              <i class="fas fa-bolt"></i> Quick Buy
            </button>
            <button class="action-btn wishlist-toggle" data-product-id="<%= product.id %>">
              <i class="far fa-heart"></i>
            </button>
          </div>
          <div class="product-meta">
            <% if (product.category) { %>
            <div class="meta-item"><strong>Category:</strong> <a href="/collection/<%= product.category.slug %>"><%= product.category.name %></a></div>
            <% } %>
            <% if (product.sku) { %><div class="meta-item"><strong>SKU:</strong> <%= product.sku %></div><% } %>
            <% if (product.material) { %><div class="meta-item"><strong>Material:</strong> <%= product.material %></div><% } %>
            <% if (product.weight) { %><div class="meta-item"><strong>Weight:</strong> <%= product.weight %></div><% } %>
            <div class="meta-item"><strong>Availability:</strong> <span class="in-stock"><%= product.stock > 0 ? 'In Stock' : 'Out of Stock' %></span></div>
          </div>
          <div class="product-share">
            <span>Share:</span>
            <a href="#" onclick="window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(window.location.href),'_blank')"><i class="fab fa-facebook-f"></i></a>
            <a href="#" onclick="window.open('https://wa.me/?text='+encodeURIComponent(window.location.href),'_blank')"><i class="fab fa-whatsapp"></i></a>
            <a href="#" onclick="window.open('https://twitter.com/intent/tweet?url='+encodeURIComponent(window.location.href),'_blank')"><i class="fab fa-twitter"></i></a>
          </div>
        </div>
      </div>

        <div class="product-tabs" data-aos="fade-up">
        <div class="tabs-header">
          <% if (product.description) { %><button class="tab-btn active" data-tab="description">Description</button><% } %>
          <button class="tab-btn <%= !product.description ? 'active' : '' %>" data-tab="specifications">Specifications</button>
          <button class="tab-btn" data-tab="reviews">Reviews</button>
        </div>
        <div class="tab-content <%= product.description ? 'active' : '' %>" id="tab-description">
          <p><%= product.description %></p>
        </div>
        <div class="tab-content <%= !product.description ? 'active' : '' %>" id="tab-specifications">
          <% if (product.specifications && product.specifications.length) { %>
          <table class="specs-table">
            <% product.specifications.forEach(function(spec) { %>
            <tr><td><%= spec.label %></td><td><%= spec.value %></td></tr>
            <% }) %>
          </table>
          <% } else { %>
          <p>Specifications not yet added.</p>
          <% } %>
        </div>
        <div class="tab-content" id="tab-reviews">
          <p>Reviews will appear here once customers purchase this product.</p>
        </div>
      </div>

      <% if (related && related.length) { %>
      <section class="related-products" data-aos="fade-up">
        <h2>Related Products</h2>
        <div class="products-grid">
          <% related.forEach(function(item) { %>
          <div class="product-card">
            <div class="product-card-image">
              <div class="product-image-placeholder-sm"><i class="fas fa-gem"></i></div>
              <button class="wishlist-toggle-sm" data-product-id="<%= item.id %>"><i class="far fa-heart"></i></button>
            </div>
            <div class="product-card-body">
              <h3><a href="/product/<%= item.slug %>"><%= item.name %></a></h3>
              <span class="price"><%= currencySymbol %> <%= Number(item.price).toLocaleString() %></span>
              <button class="btn btn-sm btn-gold add-to-cart-btn" data-product-id="<%= item.id %>">Add to Bag</button>
            </div>
          </div>
          <% }) %>
        </div>
      </section>
      <% } %>
      <% } else { %>
      <div class="empty-collection">
        <i class="fas fa-gem"></i>
        <h3>Product Not Available</h3>
        <p>This product has not been added yet. Check back soon.</p>
        <a href="/shop" class="btn btn-gold">Browse Shop</a>
      </div>
      <% } %>
    </div>
  </section>
</main>

<div class="img-lightbox" id="imgLightbox">
  <div class="img-lightbox-overlay" id="imgLightboxOverlay"></div>
  <button class="img-lightbox-close" id="imgLightboxClose"><i class="fas fa-times"></i></button>
  <button class="img-lightbox-nav img-lightbox-prev" id="imgLightboxPrev"><i class="fas fa-chevron-left"></i></button>
  <button class="img-lightbox-nav img-lightbox-next" id="imgLightboxNext"><i class="fas fa-chevron-right"></i></button>
  <div class="img-lightbox-content">
    <img src="" alt="" id="imgLightboxImg">
  </div>
  <div class="img-lightbox-counter" id="imgLightboxCounter"></div>
</div>

<script>
// Product gallery thumbnail hover
document.querySelectorAll('.thumb-item').forEach(function(item) {
  item.addEventListener('mouseenter', function() {
    var mainImg = document.getElementById('mainProductImage');
    var newSrc = this.getAttribute('data-img');
    if (mainImg && newSrc) {
      mainImg.src = newSrc;
      document.querySelectorAll('.thumb-item').forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
    }
  });
});

// Image zoom lightbox
(function() {
  var lightbox = document.getElementById('imgLightbox');
  var overlay = document.getElementById('imgLightboxOverlay');
  var closeBtn = document.getElementById('imgLightboxClose');
  var img = document.getElementById('imgLightboxImg');
  var prevBtn = document.getElementById('imgLightboxPrev');
  var nextBtn = document.getElementById('imgLightboxNext');
  var counter = document.getElementById('imgLightboxCounter');
  var zoomBtn = document.getElementById('zoomBtn');
  var mainImg = document.getElementById('mainProductImage');
  var thumbs = document.querySelectorAll('.thumb-item');
  var images = [];
  var currentIdx = 0;

  thumbs.forEach(function(t) { images.push(t.getAttribute('data-img')); });
  if (mainImg && mainImg.src && images.indexOf(mainImg.src) === -1) {
    images.unshift(mainImg.src);
  }

  function openLightbox(idx) {
    if (!images.length) return;
    currentIdx = idx;
    img.src = images[currentIdx];
    img.alt = mainImg ? mainImg.alt : '';
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
    updateCounter();
  }

  function closeLightbox() {
    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  }

  function prevImage() {
    if (images.length < 2) return;
    currentIdx = (currentIdx - 1 + images.length) % images.length;
    img.src = images[currentIdx];
    updateCounter();
  }

  function nextImage() {
    if (images.length < 2) return;
    currentIdx = (currentIdx + 1) % images.length;
    img.src = images[currentIdx];
    updateCounter();
  }

  function updateCounter() {
    if (counter && images.length > 1) {
      counter.textContent = (currentIdx + 1) + ' / ' + images.length;
    } else if (counter) {
      counter.textContent = '';
    }
  }

  if (zoomBtn) {
    zoomBtn.addEventListener('click', function(e) { e.stopPropagation(); openLightbox(0); });
  }
  if (mainImg) {
    mainImg.addEventListener('click', function() { openLightbox(0); });
  }
  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
  if (overlay) overlay.addEventListener('click', closeLightbox);
  if (prevBtn) prevBtn.addEventListener('click', prevImage);
  if (nextBtn) nextBtn.addEventListener('click', nextImage);
  document.addEventListener('keydown', function(e) {
    if (!lightbox || !lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevImage();
    if (e.key === 'ArrowRight') nextImage();
  });
  thumbs.forEach(function(t, i) {
    t.addEventListener('click', function() {
      var idx = images.length > thumbs.length ? i + 1 : i;
      openLightbox(idx);
    });
  });
})();

// Tab switching
document.querySelectorAll('.tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var tab = this.getAttribute('data-tab');
    document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
    document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });
    this.classList.add('active');
    document.getElementById('tab-' + tab).classList.add('active');
  });
});

// Quick Buy
document.querySelectorAll('.quick-buy-btn').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    var productId = this.getAttribute('data-product-id');
    var btn = this;
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    try {
      var res = await fetch('/api/cart/add', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId: Number(productId), quantity: 1 })
      });
      var data = await res.json();
      if (data.success) {
        window.showToast('Added to cart!', 'success');
        var badge = document.getElementById('cartCount');
        if (badge) badge.textContent = data.count || 1;
        var overlay = document.getElementById('cartOverlay');
        var sidebar = document.getElementById('cartSidebar');
        if (overlay && sidebar) { overlay.classList.add('active'); sidebar.classList.add('active'); }
        loadCartData();
      } else {
        window.showToast(data.message || 'Error', 'error');
      }
    } catch(e) {
      window.showToast('Connection error', 'error');
    }
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-bolt"></i> Quick Buy';
  });
});
</script>

<%- include('../partials/footer') %>