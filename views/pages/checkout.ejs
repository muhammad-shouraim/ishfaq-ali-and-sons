<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">Checkout</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <span>Cart</span> <span>/</span> <span>Checkout</span>
      </div>
    </div>
  </section>

  <section class="section checkout-section">
    <div class="container">
      <div class="checkout-layout" data-aos="fade-up">
        <div class="checkout-form-container">
          <h2>Shipping Information</h2>
          <% if (!user) { %>
          <div id="loginPrompt" style="background:var(--cream);padding:20px;border-radius:var(--radius);margin-bottom:24px;border:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
            <div>
              <strong style="font-size:0.9rem;color:var(--black)">Already have an account?</strong>
              <p style="font-size:0.82rem;color:var(--text-light);margin:4px 0 0">Sign in for faster checkout and order tracking.</p>
            </div>
            <a href="/login" class="btn btn-gold btn-sm" style="padding:8px 20px;font-size:0.72rem">Sign In</a>
          </div>
          <% } %>
          <form id="checkoutForm" class="checkout-form">
            <div class="form-group">
              <label for="name">Full Name *</label>
              <input type="text" id="name" name="name" value="<%= user ? user.name : '' %>" required>
            </div>
            <div class="form-group">
              <label for="phone">Phone Number *</label>
              <input type="tel" id="phone" name="phone" value="<%= user ? user.phone : '' %>" required>
            </div>
            <div class="form-group">
              <label for="checkoutEmail">Email Address <span style="font-weight:400;color:var(--text-light)">(optional)</span></label>
              <input type="email" id="checkoutEmail" name="email" placeholder="your@email.com">
            </div>
            <div class="form-group">
              <label for="address">Shipping Address *</label>
              <textarea id="address" name="address" rows="3" required></textarea>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="city">City *</label>
                <input type="text" id="city" name="city" required>
              </div>
              <div class="form-group">
                <label for="postalCode">Postal Code</label>
                <input type="text" id="postalCode" name="postalCode">
              </div>
            </div>
            <div class="form-group">
              <label for="notes">Order Notes</label>
              <textarea id="notes" name="notes" rows="2" placeholder="Special instructions (optional)"></textarea>
            </div>

            <h2>Payment Method</h2>
            <div class="payment-methods">
              <label class="payment-option">
                <input type="radio" name="paymentMethod" value="cod" checked>
                <div class="payment-option-content">
                  <i class="fas fa-money-bill-wave"></i>
                  <div>
                    <strong>Cash on Delivery</strong>
                    <p>Pay when you receive your order</p>
                  </div>
                </div>
              </label>
              <label class="payment-option">
                <input type="radio" name="paymentMethod" value="bank_transfer">
                <div class="payment-option-content">
                  <i class="fas fa-university"></i>
                  <div>
                    <strong>Bank Transfer</strong>
                    <p>Direct bank transfer (details provided after order)</p>
                  </div>
                </div>
              </label>
              <div id="bankDetails" style="display:none;background:var(--cream);padding:20px;border-radius:var(--radius);margin-top:8px;border:1px solid var(--border)">
                <h4 style="font-size:0.9rem;margin-bottom:12px;color:var(--gold)">Bank Account Details</h4>
                <div style="font-size:0.85rem;line-height:2;color:var(--text-light)">
                  <p><strong style="color:var(--text)">Bank:</strong> HBL (Habib Bank Limited)</p>
                  <p><strong style="color:var(--text)">Account Title:</strong> ISHFAQ ALI & SONS</p>
                  <p><strong style="color:var(--text)">Account Number:</strong> 1234-567890-01</p>
                  <p><strong style="color:var(--text)">IBAN:</strong> PK36HABB0012345678901</p>
                </div>
                <div class="form-group">
                  <label for="accountName">Account Name</label>
                  <input type="text" id="accountName" name="accountName" placeholder="Enter the name on your bank account">
                </div>
                <div class="form-group">
                  <label for="transactionId">Transaction ID / Reference</label>
                  <input type="text" id="transactionId" name="transactionId" placeholder="Enter bank transaction ID">
                </div>
              </div>

            </div>

            <label class="terms-checkbox" style="display:flex;align-items:flex-start;gap:10px;margin-bottom:16px;cursor:pointer;font-size:0.85rem;color:var(--text-light)">
              <input type="checkbox" id="termsCheck" required style="margin-top:3px;width:16px;height:16px;accent-color:var(--gold)">
              <span>I agree to the <a href="/terms" target="_blank" style="color:var(--gold);text-decoration:underline">Terms & Conditions</a> and <a href="/privacy-policy" target="_blank" style="color:var(--gold);text-decoration:underline">Privacy Policy</a></span>
            </label>
            <button type="submit" class="btn btn-gold btn-block" id="placeOrderBtn" disabled>
              Place Order
            </button>
          </form>
          <script>
            document.getElementById('termsCheck').addEventListener('change', function() {
              document.getElementById('placeOrderBtn').disabled = !this.checked;
            });
          </script>
          <script>
            document.querySelectorAll('input[name="paymentMethod"]').forEach(function(el) {
              el.addEventListener('change', function() {
                var details = document.getElementById('bankDetails');
                if (details) details.style.display = this.value === 'bank_transfer' ? 'block' : 'none';
              });
            });
          </script>
        </div>
        <aside class="checkout-summary">
          <h3>Order Summary</h3>
          <div id="checkoutItems"></div>
          <div class="summary-divider"></div>
          <div class="summary-row">
            <span>Subtotal</span>
            <span id="checkoutSubtotal">Rs. 0</span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span id="checkoutShipping">Rs. 200</span>
          </div>
          <div class="summary-row discount-row" id="checkoutDiscountRow" style="display:none">
            <span>Discount</span>
            <span id="checkoutDiscount" class="gold-text">-Rs. 0</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-row total-row">
            <span>Total</span>
            <span id="checkoutTotal">Rs. 0</span>
          </div>
        </aside>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>