<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">Shopping Cart</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <span>Cart</span>
      </div>
    </div>
  </section>

  <section class="section cart-page-section">
    <div class="container">
      <div class="cart-layout" data-aos="fade-up">
        <div class="cart-items" id="cartItems">
          <div class="empty-collection" style="text-align:center;padding:80px 20px">
            <i class="fas fa-shopping-bag" style="font-size:3rem;color:var(--gray-dark);margin-bottom:20px;display:block"></i>
            <h3 style="font-size:1.5rem;margin-bottom:12px">Your Cart is Empty</h3>
            <p style="margin-bottom:24px;font-size:1rem">Start shopping to add items to your cart.</p>
            <a href="/shop" class="btn btn-gold">Start Shopping</a>
          </div>
        </div>
        <aside class="cart-summary" id="cartSummary" style="display:none">
          <h3>Order Summary</h3>
          <div class="summary-row">
            <span>Subtotal</span>
            <span id="summarySubtotal">Rs. 0</span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span id="summaryShipping">Calculated at checkout</span>
          </div>
          <div class="summary-row discount-row" id="discountRow" style="display:none">
            <span>Discount</span>
            <span id="summaryDiscount" class="gold-text">-Rs. 0</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-row total-row">
            <span>Total</span>
            <span id="summaryTotal">Rs. 0</span>
          </div>
          <div class="coupon-section">
            <form id="couponForm">
              <input type="text" id="couponInput" placeholder="Coupon code">
              <button type="submit" class="btn btn-sm btn-outline">Apply</button>
            </form>
            <div id="couponMessage"></div>
          </div>
          <a href="/checkout" class="btn btn-gold btn-block">Proceed to Checkout</a>
          <a href="/shop" class="btn btn-outline btn-block">Continue Shopping</a>
        </aside>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>