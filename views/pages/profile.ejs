<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">My Profile</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <span>Profile</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="profile-layout" data-aos="fade-up">
        <div class="profile-sidebar">
          <div class="profile-avatar">
            <i class="fas fa-user-circle"></i>
          </div>
          <h3><%= user.name %></h3>
          <p><%= user.email %></p>
          <ul class="profile-nav">
            <li><a href="/profile" class="active">Profile</a></li>
            <li><a href="/orders">Orders</a></li>
            <li><a href="/wishlist">Wishlist</a></li>
            <li><a href="/logout">Logout</a></li>
          </ul>
        </div>
        <div class="profile-content">
          <h2>Account Details</h2>
          <form id="profileForm" class="profile-form">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" value="<%= user.name %>" required>
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" value="<%= user.email %>" disabled>
            </div>
            <div class="form-group">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>">
            </div>
            <button type="submit" class="btn btn-gold">Update Profile</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>