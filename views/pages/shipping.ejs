<% title = 'Shipping Policy'; %>
<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header" style="padding:48px 0 32px;text-align:center">
    <div class="container">
      <h1 data-aos="fade-up" style="font-size:2.2rem;margin-bottom:8px">Shipping Policy</h1>
    </div>
  </section>

  <section class="section policy-section" style="padding:60px 0">
    <div class="container">
      <div class="policy-content" data-aos="fade-up" style="max-width:800px;margin:0 auto">
        <h2 style="text-align:center;font-size:1.8rem;margin-bottom:40px;font-family:var(--font-heading)">Shipping Policy</h2>
        
        <p style="text-align:center;font-size:1rem;line-height:1.8;margin-bottom:40px;color:var(--text)">We ensure your jewelry reaches you safely and on time.</p>
        
        <div style="display:grid;gap:32px">
          <div style="background:var(--cream);padding:28px;border-radius:var(--radius);border:1px solid var(--border)">
            <h3 style="font-size:1.2rem;margin-bottom:10px;color:var(--gold)">Delivery Areas</h3>
            <p style="line-height:1.8;font-size:0.92rem;color:var(--text-light)">We currently ship across all cities in Pakistan.</p>
          </div>
          
          <div style="background:var(--cream);padding:28px;border-radius:var(--radius);border:1px solid var(--border)">
            <h3 style="font-size:1.2rem;margin-bottom:10px;color:var(--gold)">Shipping Charges</h3>
            <p style="line-height:1.8;font-size:0.92rem;color:var(--text-light)">Standard shipping: Rs. 200. Free shipping on orders above Rs. 5,000.</p>
          </div>
          
          <div style="background:var(--cream);padding:28px;border-radius:var(--radius);border:1px solid var(--border)">
            <h3 style="font-size:1.2rem;margin-bottom:10px;color:var(--gold)">Processing Time</h3>
            <p style="line-height:1.8;font-size:0.92rem;color:var(--text-light)">Orders are processed within 1-2 business days after confirmation.</p>
          </div>
          
          <div style="background:var(--cream);padding:28px;border-radius:var(--radius);border:1px solid var(--border)">
            <h3 style="font-size:1.2rem;margin-bottom:10px;color:var(--gold)">Delivery Time</h3>
            <p style="line-height:1.8;font-size:0.92rem;color:var(--text-light)">Delivery typically takes 3-5 business days within Pakistan, depending on your location.</p>
          </div>
          
          <div style="background:var(--cream);padding:28px;border-radius:var(--radius);border:1px solid var(--border)">
            <h3 style="font-size:1.2rem;margin-bottom:10px;color:var(--gold)">Order Tracking</h3>
            <p style="line-height:1.8;font-size:0.92rem;color:var(--text-light)">You will receive a tracking number once your order is shipped.</p>
          </div>
          
          <div style="background:var(--cream);padding:28px;border-radius:var(--radius);border:1px solid var(--border)">
            <h3 style="font-size:1.2rem;margin-bottom:10px;color:var(--gold)">International Shipping</h3>
            <p style="line-height:1.8;font-size:0.92rem;color:var(--text-light)">International shipping is not available yet. Stay tuned.</p>
          </div>
          
          <div style="background:var(--cream);padding:28px;border-radius:var(--radius);border:1px solid var(--border)">
            <h3 style="font-size:1.2rem;margin-bottom:10px;color:var(--gold)">Contact</h3>
            <p style="line-height:1.8;font-size:0.92rem;color:var(--text-light)">For shipping inquiries, email <a href="mailto:<%= contactEmail %>" style="color:var(--gold);text-decoration:underline"><%= contactEmail %></a> or call <%= contactPhone %>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>