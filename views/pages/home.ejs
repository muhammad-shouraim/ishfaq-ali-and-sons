<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <a href="/shop" class="hero">
    <img src="/images/main-hero.jpeg" alt="Explore Collection" style="width:100%;display:block;">
  </a>

  <% if (typeof activePromotion !== 'undefined' && activePromotion) { %>
  <section class="flash-sale-banner">
    <div class="container">
      <div class="flash-sale-content">
        <div class="flash-sale-text">
          <span class="flash-tag"><i class="fas fa-bolt"></i> FLASH SALE</span>
          <h2><%= activePromotion.title %></h2>
          <p><%= activePromotion.description %></p>
          <% if (activePromotion.discountPercent > 0) { %>
          <div class="flash-discount"><span class="discount-badge"><%= activePromotion.discountPercent %>% OFF</span></div>
          <% } %>
          <div class="flash-countdown" data-end="<%= new Date(activePromotion.endDate).toISOString() %>">
            <div class="countdown-item"><span class="countdown-num" id="flashDays">00</span><span class="countdown-label">Days</span></div>
            <div class="countdown-item"><span class="countdown-num" id="flashHours">00</span><span class="countdown-label">Hours</span></div>
            <div class="countdown-item"><span class="countdown-num" id="flashMins">00</span><span class="countdown-label">Mins</span></div>
            <div class="countdown-item"><span class="countdown-num" id="flashSecs">00</span><span class="countdown-label">Secs</span></div>
          </div>
          <a href="<%= activePromotion.linkUrl || '/shop' %>" class="btn btn-gold">Shop Now</a>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Category Slider -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Categories</span>
        <h2>Shop by <span class="gold-text">Category</span></h2>
        <p>Browse our exquisite collections</p>
      </div>
      <div class="product-carousel">
        <button class="carousel-btn carousel-prev"><i class="fas fa-chevron-left"></i></button>
        <div class="product-carousel-track">
          <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.forEach(function(cat) { %>
            <div class="product-card">
              <a href="/collection/<%= cat.slug %>" class="product-card-image">
                <% if (cat.image) { %>
                  <img src="<%= cat.image %>" alt="<%= cat.name %>">
                <% } else { %>
                  <div class="placeholder-box"><i class="fas fa-gem"></i></div>
                <% } %>
              </a>
              <div class="product-card-body">
                <h3><a href="/collection/<%= cat.slug %>"><%= cat.name %></a></h3>
              </div>
            </div>
            <% }) %>
          <% } else { %>
            <div class="product-card">
              <a href="/shop" class="product-card-image">
                <div class="placeholder-box"><i class="fas fa-gem"></i></div>
              </a>
              <div class="product-card-body">
                <h3><a href="/shop">All Jewelry</a></h3>
              </div>
            </div>
          <% } %>
        </div>
        <button class="carousel-btn carousel-next"><i class="fas fa-chevron-right"></i></button>
      </div>
    </div>
  </section>

  <!-- Best Sellers -->
  <section class="section bg-cream">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Top Picks</span>
        <h2>Best <span class="gold-text">Sellers</span></h2>
        <p>Our most loved pieces</p>
      </div>
      <div class="product-carousel">
        <button class="carousel-btn carousel-prev" aria-label="Previous"><i class="fas fa-chevron-left"></i></button>
        <div class="product-carousel-track">
          <% if (typeof bestSellers !== 'undefined' && bestSellers.length > 0) { %>
            <% bestSellers.forEach(function(product) { %>
              <div class="product-card" data-images='<%= JSON.stringify(product.images || []) %>'>
                <div class="product-card-image">
                  <a href="/product/<%= product.slug %>">
                    <img class="main-img" src="<%= product.thumbnail || '/images/newlogo.png' %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
                    <img class="hover-img" src="<%= (product.images && product.images[0]) ? product.images[0] : (product.thumbnail || '/images/newlogo.png') %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
                  </a>
                  <% if (product.comparePrice > 0) { %>
                    <span class="badge badge-sale">Sale</span>
                  <% } %>
                </div>
                <div class="product-card-body">
                  <h3><a href="/product/<%= product.slug %>"><%= product.name %></a></h3>
                  <% if (product.comparePrice > 0) { %>
                    <span class="price old-price">Rs. <%= Number(product.price).toLocaleString() %></span>
                    <span class="price sale-price">Rs. <%= Number(product.comparePrice).toLocaleString() %></span>
                  <% } else { %>
                    <span class="price">Rs. <%= Number(product.price).toLocaleString() %></span>
                  <% } %>
                </div>
              </div>
            <% }) %>
            <% for (var pi = bestSellers.length; pi < 4; pi++) { %><div class="product-card product-card-placeholder"></div><% } %>
          <% } else { %>
            <% for (var pi = 0; pi < 4; pi++) { %><div class="product-card product-card-placeholder"></div><% } %>
            <div class="empty-carousel">
              <i class="fas fa-gem"></i>
              <p><a href="/shop">Coming Soon — Browse our collection</a></p>
            </div>
          <% } %>
        </div>
        <button class="carousel-btn carousel-next" aria-label="Next"><i class="fas fa-chevron-right"></i></button>
      </div>
    </div>
  </section>

  <a href="/shop" class="section" style="display:block;line-height:0">
    <img src="/images/center-hero.jpeg" alt="Shop Now" style="width:100%;display:block;">
  </a>

  <!-- New Arrivals -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Latest</span>
        <h2>New <span class="gold-text">Arrivals</span></h2>
        <p>Fresh from our workshop</p>
      </div>
      <div class="product-carousel">
        <button class="carousel-btn carousel-prev" aria-label="Previous"><i class="fas fa-chevron-left"></i></button>
        <div class="product-carousel-track">
          <% if (typeof newArrivals !== 'undefined' && newArrivals.length > 0) { %>
            <% newArrivals.forEach(function(product) { %>
              <div class="product-card" data-images='<%= JSON.stringify(product.images || []) %>'>
                <div class="product-card-image">
                  <a href="/product/<%= product.slug %>">
                    <img class="main-img" src="<%= product.thumbnail || '/images/newlogo.png' %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
                    <img class="hover-img" src="<%= (product.images && product.images[0]) ? product.images[0] : (product.thumbnail || '/images/newlogo.png') %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
                  </a>
                  <span class="badge badge-new">New</span>
                </div>
                <div class="product-card-body">
                  <h3><a href="/product/<%= product.slug %>"><%= product.name %></a></h3>
                  <% if (product.comparePrice > 0) { %>
                    <span class="price old-price">Rs. <%= Number(product.price).toLocaleString() %></span>
                    <span class="price sale-price">Rs. <%= Number(product.comparePrice).toLocaleString() %></span>
                  <% } else { %>
                    <span class="price">Rs. <%= Number(product.price).toLocaleString() %></span>
                  <% } %>
                </div>
              </div>
            <% }) %>
            <% for (var pi = newArrivals.length; pi < 4; pi++) { %><div class="product-card product-card-placeholder"></div><% } %>
          <% } else { %>
            <% for (var pi = 0; pi < 4; pi++) { %><div class="product-card product-card-placeholder"></div><% } %>
            <div class="empty-carousel">
              <i class="fas fa-gem"></i>
              <p><a href="/shop">Coming Soon — Browse our collection</a></p>
            </div>
          <% } %>
        </div>
        <button class="carousel-btn carousel-next" aria-label="Next"><i class="fas fa-chevron-right"></i></button>
      </div>
    </div>
  </section>

  <!-- Sale Products -->
  <% if (typeof saleProducts !== 'undefined' && saleProducts.length > 0) { %>
  <section class="section bg-cream">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Offers</span>
        <h2>On <span class="gold-text">Sale</span></h2>
        <p>Best deals on premium jewelry</p>
      </div>
      <div class="product-carousel">
        <button class="carousel-btn carousel-prev" aria-label="Previous"><i class="fas fa-chevron-left"></i></button>
        <div class="product-carousel-track">
          <% saleProducts.forEach(function(product) { %>
            <div class="product-card" data-images='<%= JSON.stringify(product.images || []) %>'>
              <div class="product-card-image">
                <a href="/product/<%= product.slug %>">
                  <img class="main-img" src="<%= product.thumbnail || '/images/newlogo.png' %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
                  <img class="hover-img" src="<%= (product.images && product.images[0]) ? product.images[0] : (product.thumbnail || '/images/newlogo.png') %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
                </a>
                <span class="badge badge-sale">Sale</span>
              </div>
              <div class="product-card-body">
                <h3><a href="/product/<%= product.slug %>"><%= product.name %></a></h3>
                <span class="price old-price">Rs. <%= Number(product.price).toLocaleString() %></span>
                <span class="price sale-price">Rs. <%= Number(product.comparePrice).toLocaleString() %></span>
              </div>
            </div>
          <% }) %>
          <% for (var pi = saleProducts.length; pi < 4; pi++) { %><div class="product-card product-card-placeholder"></div><% } %>
        </div>
        <button class="carousel-btn carousel-next" aria-label="Next"><i class="fas fa-chevron-right"></i></button>
      </div>
    </div>
  </section>
  <% } %>

  <!-- All Products -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Collection</span>
        <h2>Shop <span class="gold-text">All</span></h2>
        <p>Complete collection of premium jewelry</p>
      </div>
      <div class="products-grid">
        <% if (typeof allProducts !== 'undefined' && allProducts.length > 0) { %>
          <% allProducts.forEach(function(product) { %>
            <div class="product-card" data-images='<%= JSON.stringify(product.images || []) %>'>
              <div class="product-card-image">
                <a href="/product/<%= product.slug %>">
                  <img class="main-img" src="<%= product.thumbnail || '/images/newlogo.png' %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
                  <img class="hover-img" src="<%= (product.images && product.images[0]) ? product.images[0] : (product.thumbnail || '/images/newlogo.png') %>" alt="<%= product.name %>" onerror="this.onerror=null;this.src='/images/newlogo.png'">
                </a>
                <% if (product.comparePrice > 0) { %>
                  <span class="badge badge-sale">Sale</span>
                <% } %>
              </div>
              <div class="product-card-body">
                <h3><a href="/product/<%= product.slug %>"><%= product.name %></a></h3>
                <% if (product.comparePrice > 0) { %>
                  <span class="price old-price">Rs. <%= Number(product.price).toLocaleString() %></span>
                  <span class="price sale-price">Rs. <%= Number(product.comparePrice).toLocaleString() %></span>
                <% } else { %>
                  <span class="price">Rs. <%= Number(product.price).toLocaleString() %></span>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="product-card">
            <div class="product-card-image"><div class="placeholder-box" style="height:100%;min-height:200px"><i class="fas fa-gem"></i></div></div>
            <div class="product-card-body"><h3><a href="/shop">Coming Soon</a></h3><span class="price">Rs. 0</span></div>
          </div>
        <% } %>
      </div>
      <div class="pagination" style="margin-top:40px">
        <a href="/shop" class="btn btn-gold">View All Products</a>
      </div>
    </div>
  </section>
</main>

<script>

// Product carousel
function initProductCarousel(container) {
  var track = container.querySelector('.product-carousel-track');
  var prev = container.querySelector('.carousel-prev');
  var next = container.querySelector('.carousel-next');
  if (!track) return;

  function getVisibleCount() {
    var w = window.innerWidth;
    if (w < 768) return 2;
    if (w < 1025) return 3;
    return 4;
  }

  function getCardWidth() {
    var card = track.querySelector('.product-card');
    if (!card) return 0;
    var style = getComputedStyle(track);
    var gap = parseInt(style.columnGap || style.gap) || 20;
    return card.offsetWidth + gap;
  }

  function scrollTo(direction) {
    var cardW = getCardWidth();
    if (cardW <= 0) return;
    var visible = getVisibleCount();
    track.scrollBy({ left: direction * cardW * visible, behavior: 'smooth' });
  }

  if (prev) prev.addEventListener('click', function() { scrollTo(-1); });
  if (next) next.addEventListener('click', function() { scrollTo(1); });

  // Touch swipe
  var startX, startScroll, isDown = false;
  track.addEventListener('touchstart', function(e) {
    startX = e.touches[0].pageX;
    startScroll = track.scrollLeft;
    isDown = true;
  }, { passive: true });
  track.addEventListener('touchmove', function(e) {
    if (!isDown) return;
    var dx = startX - e.touches[0].pageX;
    track.scrollLeft = startScroll + dx;
  }, { passive: true });
  track.addEventListener('touchend', function() { isDown = false; }, { passive: true });

  // Hide/show arrows on scroll
  function updateArrows() {
    var maxScroll = track.scrollWidth - track.clientWidth;
    if (prev) prev.style.display = track.scrollLeft <= 5 ? 'none' : '';
    if (next) next.style.display = track.scrollLeft >= maxScroll - 5 ? 'none' : '';
  }
  track.addEventListener('scroll', updateArrows);
  setTimeout(updateArrows, 100);
  window.addEventListener('resize', updateArrows);
}

document.querySelectorAll('.product-carousel').forEach(initProductCarousel);

// Product card image hover & click navigation
document.querySelectorAll('.product-card').forEach(function(card) {
  var mainImg = card.querySelector('.main-img');
  var hoverImg = card.querySelector('.hover-img');
  if (mainImg && hoverImg) {
    card.addEventListener('mouseenter', function() { mainImg.style.opacity = '0'; hoverImg.style.opacity = '1'; });
    card.addEventListener('mouseleave', function() { mainImg.style.opacity = '1'; hoverImg.style.opacity = '0'; });
  }
  card.addEventListener('click', function(e) {
    if (e.target.closest('a') || e.target.closest('button')) return;
    var link = card.querySelector('a[href^="/product/"], a[href^="/collection/"]');
    if (link) window.location.href = link.getAttribute('href');
  });
});
</script>

<%- include('../partials/footer') %>