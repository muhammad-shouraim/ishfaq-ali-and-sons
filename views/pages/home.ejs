<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-slider">
      <div class="hero-slide active">
        <div class="hero-bg"></div>
        <div class="container">
          <div class="hero-content" data-aos="fade-up">
            <span class="hero-subtitle">ISHFAQ ALI & SONS</span>
            <h1>Exquisite <span class="gold-text">Luxury</span> Jewelry</h1>
            <p>Discover timeless elegance in every piece. Handcrafted Karit and Turkish Jewelry that defines sophistication.</p>
            <div class="hero-buttons">
              <a href="/shop" class="btn btn-gold">Explore Collection</a>
              <a href="/categories" class="btn btn-outline-light">View Categories</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-scroll">
      <span>Scroll</span>
      <i class="fas fa-chevron-down"></i>
    </div>
  </section>

  <!-- Featured Categories -->
  <section class="section categories-section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section-tag">Collections</span>
        <h2>Our <span class="gold-text">Categories</span></h2>
        <p>Explore our curated collections of premium jewelry</p>
      </div>
      <div class="categories-grid">
        <a href="/category/karit" class="category-card" data-aos="fade-up" data-aos-delay="100">
          <div class="category-icon">
            <i class="fas fa-crown"></i>
          </div>
          <h3>Karit</h3>
          <p>Traditional elegance with a modern touch. Discover our exquisite Karit collection.</p>
          <span class="category-link">Explore <i class="fas fa-arrow-right"></i></span>
        </a>
        <a href="/category/turkish-jewelry" class="category-card" data-aos="fade-up" data-aos-delay="200">
          <div class="category-icon">
            <i class="fas fa-gem"></i>
          </div>
          <h3>Turkish Jewelry</h3>
          <p>Inspired by Ottoman grandeur. Premium Turkish craftsmanship meets luxury.</p>
          <span class="category-link">Explore <i class="fas fa-arrow-right"></i></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Premium Collection -->
  <section class="section premium-section bg-cream">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section-tag">Premium</span>
        <h2>Premium <span class="gold-text">Collection</span></h2>
        <p>Curated pieces for the discerning collector</p>
      </div>
      <div class="empty-collection" data-aos="fade-up">
        <i class="fas fa-gem"></i>
        <h3>Coming Soon</h3>
        <p>Our premium collection is being curated with the finest pieces. Stay tuned.</p>
      </div>
    </div>
  </section>

  <!-- Trending Section -->
  <section class="section trending-section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section-tag">Trending</span>
        <h2>Trending <span class="gold-text">Now</span></h2>
        <p>Most sought-after pieces this season</p>
      </div>
      <div class="empty-collection" data-aos="fade-up">
        <i class="fas fa-fire"></i>
        <h3>Coming Soon</h3>
        <p>Trending pieces will appear here soon.</p>
      </div>
    </div>
  </section>

  <!-- New Arrivals -->
  <section class="section new-arrivals-section bg-cream">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section-tag">New</span>
        <h2>New <span class="gold-text">Arrivals</span></h2>
        <p>The latest additions to our collection</p>
      </div>
      <div class="empty-collection" data-aos="fade-up">
        <i class="fas fa-star"></i>
        <h3>Coming Soon</h3>
        <p>New arrivals will be showcased here.</p>
      </div>
    </div>
  </section>

  <!-- Luxury Banner -->
  <section class="luxury-banner">
    <div class="container">
      <div class="banner-content" data-aos="fade-up">
        <span class="banner-tag">Since Generations</span>
        <h2>Crafted for <span class="gold-text">Eternity</span></h2>
        <p>Each piece tells a story of heritage, passion, and unparalleled craftsmanship.</p>
        <a href="/about" class="btn btn-gold">Our Story</a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section why-section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section-tag">Why Us</span>
        <h2>Why Choose <span class="gold-text">Us</span></h2>
      </div>
      <div class="features-grid">
        <div class="feature-card" data-aos="fade-up" data-aos-delay="100">
          <div class="feature-icon"><i class="fas fa-award"></i></div>
          <h3>Premium Quality</h3>
          <p>Finest materials and exceptional craftsmanship in every piece.</p>
        </div>
        <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
          <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
          <h3>Authenticity Guaranteed</h3>
          <p>100% genuine products with authenticity certification.</p>
        </div>
        <div class="feature-card" data-aos="fade-up" data-aos-delay="300">
          <div class="feature-icon"><i class="fas fa-truck"></i></div>
          <h3>Free Delivery</h3>
          <p>Free shipping on orders above Rs. 5,000.</p>
        </div>
        <div class="feature-card" data-aos="fade-up" data-aos-delay="400">
          <div class="feature-icon"><i class="fas fa-exchange-alt"></i></div>
          <h3>Easy Returns</h3>
          <p>Hassle-free return policy for your peace of mind.</p>
        </div>
        <div class="feature-card" data-aos="fade-up" data-aos-delay="500">
          <div class="feature-icon"><i class="fas fa-headset"></i></div>
          <h3>24/7 Support</h3>
          <p>Dedicated customer support via WhatsApp and phone.</p>
        </div>
        <div class="feature-card" data-aos="fade-up" data-aos-delay="600">
          <div class="feature-icon"><i class="fas fa-lock"></i></div>
          <h3>Secure Shopping</h3>
          <p>Safe and secure checkout with data protection.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Customer Reviews -->
  <section class="section reviews-section bg-cream">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section-tag">Testimonials</span>
        <h2>What Our <span class="gold-text">Clients Say</span></h2>
      </div>
      <div class="reviews-grid">
        <div class="review-card" data-aos="fade-up" data-aos-delay="100">
          <div class="review-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <p>"Absolutely stunning pieces! The craftsmanship is exceptional. Highly recommended."</p>
          <div class="review-author">
            <div class="review-avatar"><i class="fas fa-user-circle"></i></div>
            <div>
              <strong>Ayesha K.</strong>
              <span>Verified Buyer</span>
            </div>
          </div>
        </div>
        <div class="review-card" data-aos="fade-up" data-aos-delay="200">
          <div class="review-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <p>"Beautiful Turkish jewelry. The design and quality exceeded my expectations."</p>
          <div class="review-author">
            <div class="review-avatar"><i class="fas fa-user-circle"></i></div>
            <div>
              <strong>Fatima Z.</strong>
              <span>Verified Buyer</span>
            </div>
          </div>
        </div>
        <div class="review-card" data-aos="fade-up" data-aos-delay="300">
          <div class="review-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <p>"Perfect customer service and fast delivery. My Karit set is absolutely gorgeous."</p>
          <div class="review-author">
            <div class="review-avatar"><i class="fas fa-user-circle"></i></div>
            <div>
              <strong>Zara M.</strong>
              <span>Verified Buyer</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Instagram Gallery -->
  <section class="section gallery-section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="section-tag">Follow Us</span>
        <h2><span class="gold-text">@ishfaqaliandsons</span></h2>
        <p>Follow us on Instagram for daily inspiration</p>
      </div>
      <div class="gallery-grid">
        <div class="gallery-item" data-aos="fade-up"><div class="gallery-placeholder"><i class="fab fa-instagram"></i></div></div>
        <div class="gallery-item" data-aos="fade-up" data-aos-delay="100"><div class="gallery-placeholder"><i class="fab fa-instagram"></i></div></div>
        <div class="gallery-item" data-aos="fade-up" data-aos-delay="200"><div class="gallery-placeholder"><i class="fab fa-instagram"></i></div></div>
        <div class="gallery-item" data-aos="fade-up" data-aos-delay="300"><div class="gallery-placeholder"><i class="fab fa-instagram"></i></div></div>
        <div class="gallery-item" data-aos="fade-up" data-aos-delay="400"><div class="gallery-placeholder"><i class="fab fa-instagram"></i></div></div>
        <div class="gallery-item" data-aos="fade-up" data-aos-delay="500"><div class="gallery-placeholder"><i class="fab fa-instagram"></i></div></div>
      </div>
    </div>
  </section>

  <!-- Brand Story -->
  <section class="brand-story bg-cream">
    <div class="container">
      <div class="story-content" data-aos="fade-up">
        <span class="section-tag">Our Heritage</span>
        <h2>The <span class="gold-text">ISHFAQ ALI & SONS</span> Legacy</h2>
        <p>For generations, ISHFAQ ALI & SONS has been synonymous with luxury and elegance. Our journey began with a passion for creating jewelry that transcends time — pieces that tell stories, celebrate traditions, and embody the finest craftsmanship.</p>
        <p>Today, we continue this legacy by curating the most exquisite Karit and Turkish Jewelry collections, bringing together traditional artistry and contemporary design.</p>
        <a href="/about" class="btn btn-outline">Read Our Story</a>
      </div>
    </div>
  </section>
</main>

