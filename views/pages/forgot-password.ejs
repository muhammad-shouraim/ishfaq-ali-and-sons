<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">Forgot Password</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <span>Forgot Password</span>
      </div>
    </div>
  </section>

  <section class="section auth-section">
    <div class="container">
      <div class="auth-card" data-aos="fade-up">
        <div class="auth-logo">
          <img src="/images/logo.jpeg" alt="ISHFAQ ALI & SONS">
        </div>
        <h2>Reset Password</h2>
        <p class="auth-subtitle">Enter your email and we'll send reset instructions</p>
        <form id="forgotForm" class="auth-form">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="your@email.com" required>
          </div>
          <button type="submit" class="btn btn-gold btn-block">Send Reset Link</button>
        </form>
        <p class="auth-footer"><a href="/login">Back to Login</a></p>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>