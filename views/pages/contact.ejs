<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">Contact Us</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <span>Contact</span>
      </div>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container">
      <div class="contact-layout" data-aos="fade-up">
        <div class="contact-info">
          <h2>Get in <span class="gold-text">Touch</span></h2>
          <p>We would love to hear from you. Reach out for inquiries, custom orders, or any questions.</p>
          <div class="contact-details">
            <div class="contact-item">
              <i class="fab fa-whatsapp"></i>
              <div>
                <h4>WhatsApp</h4>
                <a href="https://wa.me/<%= whatsappNumber %>" target="_blank"><%= contactPhone %></a>
              </div>
            </div>
            <div class="contact-item">
              <i class="fas fa-phone-alt"></i>
              <div>
                <h4>Phone</h4>
                <a href="tel:<%= contactPhone %>"><%= contactPhone %></a>
              </div>
            </div>
            <% if (contactEmail) { %>
            <div class="contact-item">
              <i class="fas fa-envelope"></i>
              <div>
                <h4>Email</h4>
                <a href="mailto:<%= contactEmail %>"><%= contactEmail %></a>
              </div>
            </div>
            <% } %>
            <div class="contact-item">
              <i class="fas fa-map-marker-alt"></i>
              <div>
                <h4>Location</h4>
                <p><%= address %></p>
                <a href="<%= googleMapsUrl %>" target="_blank" class="btn btn-sm btn-outline" style="margin-top:8px;display:inline-flex;">
                  <i class="fas fa-map-marker-alt"></i> Get Directions
                </a>
              </div>
            </div>
            <div class="contact-item">
              <i class="fab fa-facebook"></i>
              <div>
                <h4>Facebook</h4>
                <a href="<%= socialLinks.facebook %>" target="_blank">Follow us on Facebook</a>
              </div>
            </div>
            <div class="contact-item">
              <i class="fab fa-tiktok"></i>
              <div>
                <h4>TikTok</h4>
                <a href="<%= socialLinks.tiktok %>" target="_blank">Follow us on TikTok</a>
              </div>
            </div>
          </div>
        </div>
        <div class="contact-form-container">
          <h3>Send us a Message</h3>
          <form id="contactForm" class="contact-form">
            <div class="form-group">
              <label for="name">Name *</label>
              <input type="text" id="name" name="name" placeholder="Your name" required>
            </div>
            <div class="form-group">
              <label for="phone">Phone *</label>
              <input type="tel" id="phone" name="phone" placeholder="Your phone number" required>
            </div>
            <div class="form-group">
              <label for="message">Message *</label>
              <textarea id="message" name="message" rows="5" placeholder="Your message" required></textarea>
            </div>
            <button type="submit" class="btn btn-gold">Send Message</button>
          </form>
        </div>
      </div>

      <div class="map-container" data-aos="fade-up">
        <iframe
          src="https://www.google.com/maps?q=piple+wehra+near+aik+minar+wali+masjid+Shah+Alam+Mohalla+Takia+Sadhu+market+Lahore+54009+Pakistan&output=embed"
          width="100%" height="400" style="border:0;border-radius:12px;" allowfullscreen="" loading="lazy">
        </iframe>
        <div style="text-align:center;margin-top:16px;">
          <a href="<%= googleMapsUrl %>" target="_blank" class="btn btn-gold">
            <i class="fas fa-map-marker-alt"></i> Get Directions
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>