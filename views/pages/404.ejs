<% title = '404'; %>
<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up" style="text-align:center">404</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50" style="text-align:center;justify-content:center">
        <a href="/">Home</a> <span>/</span> <span>404</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="error-page" data-aos="fade-up" style="text-align:center;max-width:600px;margin:0 auto">
        <div class="error-code" style="font-size:6rem;font-family:var(--font-heading);color:var(--gold);font-weight:600;line-height:1;margin-bottom:16px">404</div>
        <h2 style="margin-bottom:12px">Page Not Found</h2>
        <p style="margin-bottom:24px;font-size:1rem"><%= typeof message !== 'undefined' ? message : 'The page you are looking for does not exist or has been moved.' %></p>
        <div class="error-actions" style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <a href="/" class="btn btn-gold">Go Home</a>
          <a href="/shop" class="btn btn-outline">Browse Shop</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>