<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">Page Not Found</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <span>404</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="error-page" data-aos="fade-up">
        <div class="error-code">404</div>
        <h2>Page Not Found</h2>
        <p><%= typeof message !== 'undefined' ? message : 'The page you are looking for does not exist or has been moved.' %></p>
        <div class="error-actions">
          <a href="/" class="btn btn-gold">Go Home</a>
          <a href="/shop" class="btn btn-outline">Browse Shop</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>