<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">About Us</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <span>About</span>
      </div>
    </div>
  </section>

  <section class="section about-section">
    <div class="container">
      <div class="about-hero" data-aos="fade-up">
        <div class="about-hero-icon">
          <i class="fas fa-crown"></i>
        </div>
        <h2>Our <span class="gold-text">Story</span></h2>
      </div>

      <div class="about-content" data-aos="fade-up">
        <div class="about-text">
          <h3>Generations of Excellence</h3>
          <p>ISHFAQ ALI & SONS has been a name synonymous with luxury, trust, and exceptional craftsmanship. Our journey began with a vision to bring the finest jewelry to discerning customers who appreciate the art of fine adornment.</p>
          <p>Specializing in <strong>Karit</strong> and <strong>Turkish Jewelry</strong>, we curate collections that blend traditional artistry with contemporary elegance. Every piece in our collection tells a story of heritage, passion, and meticulous attention to detail.</p>
          <p>We believe that jewelry is more than an accessory — it is an expression of identity, a celebration of moments, and a legacy to be passed down through generations.</p>
        </div>
      </div>

      <div class="about-values" data-aos="fade-up">
        <h3>Our Values</h3>
        <div class="values-grid">
          <div class="value-card">
            <i class="fas fa-gem"></i>
            <h4>Quality</h4>
            <p>Uncompromising quality in every piece we offer.</p>
          </div>
          <div class="value-card">
            <i class="fas fa-handshake"></i>
            <h4>Trust</h4>
            <p>Building lasting relationships through transparency and integrity.</p>
          </div>
          <div class="value-card">
            <i class="fas fa-history"></i>
            <h4>Heritage</h4>
            <p>Honoring traditions while embracing modern elegance.</p>
          </div>
          <div class="value-card">
            <i class="fas fa-star"></i>
            <h4>Excellence</h4>
            <p>Striving for perfection in everything we do.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

