<%- include('../partials/header') %>
<%- include('../partials/topbar') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1 data-aos="fade-up">About Us</h1>
      <div class="breadcrumb" data-aos="fade-up" data-aos-delay="50">
        <a href="/">Home</a> <span>/</span> <span>About</span>
      </div>
    </div>
  </section>

  <section class="section about-section">
    <div class="container">
      <div class="about-hero" data-aos="fade-up" style="text-align:center">
        <div class="about-hero-icon" style="width:72px;height:72px;margin:0 auto 20px;background:var(--cream);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.8rem;color:var(--gold)">
          <i class="fas fa-crown"></i>
        </div>
        <h2 style="font-size:2rem;margin-bottom:12px">Our <span class="gold-text">Story</span></h2>
        <p style="max-width:650px;margin:0 auto;font-size:1rem;color:var(--text-light);line-height:1.8">For generations, ISHFAQ ALI & SONS has been synonymous with luxury, trust, and exceptional craftsmanship.</p>
      </div>

      <div class="about-content" data-aos="fade-up" style="text-align:center;max-width:800px;margin:40px auto 0">
        <div class="about-text">
          <h3 style="text-align:center;font-size:1.3rem;margin-bottom:20px">Generations of Excellence</h3>
          <p style="text-align:center;line-height:1.9;margin-bottom:16px">ISHFAQ ALI & SONS has been a name synonymous with luxury, trust, and exceptional craftsmanship. Our journey began with a vision to bring the finest jewelry to discerning customers who appreciate the art of fine adornment.</p>
          <p style="text-align:center;line-height:1.9;margin-bottom:16px">Specializing in <strong>Karit</strong> and <strong>Turkish Jewelry</strong>, we curate collections that blend traditional artistry with contemporary elegance. Every piece in our collection tells a story of heritage, passion, and meticulous attention to detail.</p>
          <p style="text-align:center;line-height:1.9;margin-bottom:16px">We believe that jewelry is more than an accessory — it is an expression of identity, a celebration of moments, and a legacy to be passed down through generations.</p>
        </div>
      </div>

      <div class="about-values" data-aos="fade-up" style="margin-top:60px">
        <h3 style="text-align:center;font-size:1.5rem;margin-bottom:32px">Our Values</h3>
        <div class="values-grid">
          <div class="value-card" style="text-align:center;padding:32px 20px;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);transition:all 0.3s ease">
            <i class="fas fa-gem" style="font-size:2rem;color:var(--gold);margin-bottom:16px"></i>
            <h4 style="font-size:1rem;margin-bottom:8px">Quality</h4>
            <p style="font-size:0.85rem;color:var(--text-light);line-height:1.6">Uncompromising quality in every piece we offer.</p>
          </div>
          <div class="value-card" style="text-align:center;padding:32px 20px;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);transition:all 0.3s ease">
            <i class="fas fa-handshake" style="font-size:2rem;color:var(--gold);margin-bottom:16px"></i>
            <h4 style="font-size:1rem;margin-bottom:8px">Trust</h4>
            <p style="font-size:0.85rem;color:var(--text-light);line-height:1.6">Building lasting relationships through transparency.</p>
          </div>
          <div class="value-card" style="text-align:center;padding:32px 20px;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);transition:all 0.3s ease">
            <i class="fas fa-history" style="font-size:2rem;color:var(--gold);margin-bottom:16px"></i>
            <h4 style="font-size:1rem;margin-bottom:8px">Heritage</h4>
            <p style="font-size:0.85rem;color:var(--text-light);line-height:1.6">Honoring traditions while embracing modern elegance.</p>
          </div>
          <div class="value-card" style="text-align:center;padding:32px 20px;background:var(--white);border:1px solid var(--border);border-radius:var(--radius);transition:all 0.3s ease">
            <i class="fas fa-star" style="font-size:2rem;color:var(--gold);margin-bottom:16px"></i>
            <h4 style="font-size:1rem;margin-bottom:8px">Excellence</h4>
            <p style="font-size:0.85rem;color:var(--text-light);line-height:1.6">Striving for perfection in everything we do.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
