<%- include('../partials/header') %>

<style>
.tab-nav { display: flex; gap: 4px; margin-bottom: 20px; flex-wrap: wrap; }
.tab-nav .tab-link { padding: 10px 18px; border-radius: 6px; font-size: 0.82rem; font-weight: 500; cursor: default; text-decoration: none; color: var(--admin-text-light); background: #f0f0f0; transition: all 0.3s; border: 1px solid transparent; pointer-events: none; }
.tab-nav .tab-link.active { color: var(--admin-gold-dark); background: #fff8e0; border-color: var(--admin-gold); }
.tab-nav .tab-link.done { color: var(--admin-success); background: #e8f5e9; }
.tab-pane { display: none; }
.tab-pane.active { display: block; }
.tab-nav-buttons { display: flex; gap: 10px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--admin-border); }
.btn-next, .btn-prev { padding: 10px 24px; border: none; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.3s; }
.btn-next { background: var(--admin-gold); color: #fff; }
.btn-next:hover { background: var(--admin-gold-dark); }
.btn-prev { background: #e0e0e0; color: var(--admin-text); }
.btn-prev:hover { background: #ccc; }
.btn-next:disabled { opacity: 0.5; cursor: not-allowed; }
@keyframes shake { 0%,100% { transform: translateX(0); } 20%,60% { transform: translateX(-6px); } 40%,80% { transform: translateX(6px); } }
.shake { animation: shake 0.4s ease-in-out; }
</style>

<div class="page-header">
  <h1 class="page-title"><%= isEditing ? 'Edit Product' : 'Create Product' %></h1>
  <a href="<%= adminPath %>/products" class="admin-btn">Back to Products</a>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <form action="<%= adminPath %>/products<%= isEditing ? '/edit/' + product.id : '/create' %>" method="POST" enctype="multipart/form-data" class="admin-form" id="productForm">
      <% if (isEditing) { %>
        <input type="hidden" name="_method" value="PUT">
      <% } %>

      <nav class="tab-nav" id="tabNav">
        <a href="#tab-basic" class="tab-link active" data-index="0">1. Basic</a>
        <a href="#tab-pricing" class="tab-link" data-index="1">2. Pricing</a>
        <a href="#tab-inventory" class="tab-link" data-index="2">3. Inventory</a>
        <a href="#tab-description" class="tab-link" data-index="3">4. Description</a>
        <a href="#tab-media" class="tab-link" data-index="4">5. Media</a>
        <a href="#tab-attributes" class="tab-link" data-index="5">6. Attributes</a>
        <a href="#tab-seo" class="tab-link" data-index="6">7. SEO</a>
        <a href="#tab-variants" class="tab-link" data-index="7">8. Variants</a>
        <a href="#tab-specs" class="tab-link" data-index="8">9. Specifications</a>
      </nav>

      <div class="tab-content">
        <div id="tab-basic" class="tab-pane active">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Product Name *</label>
              <input type="text" id="name" name="name" class="form-input" value="<%= isEditing ? product.name : '' %>" required oninput="autoGenerateSlug(this.value)">
            </div>
            <div class="form-group">
              <label for="slug">Slug</label>
              <input type="text" id="slug" name="slug" class="form-input" value="<%= isEditing ? product.slug : '' %>" readonly>
              <span class="form-hint">Auto-generated from product name</span>
            </div>
          </div>
          <div class="form-group">
            <label for="sku">SKU</label>
            <input type="text" id="sku" name="sku" class="form-input" value="<%= isEditing ? product.sku : '' %>">
            <span class="form-hint">Leave blank to auto-generate</span>
          </div>
          <div class="form-group">
            <label for="categoryId">Category *</label>
            <select id="categoryId" name="categoryId" class="form-input" required onchange="loadSubcategories(this.value)">
              <option value="">Select Main Category</option>
              <% if (typeof parentCategories !== 'undefined') { %>
                <% parentCategories.forEach(function(cat) { %>
                <option value="<%= cat.id %>" <%= isEditing && product.category == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="form-group" id="subcategoryGroup" style="display:none">
            <label for="subcategoryId">Subcategory</label>
            <select id="subcategoryId" name="subcategoryId" class="form-input" onchange="loadSubSubcategories(this.value)">
              <option value="">Select Subcategory</option>
            </select>
          </div>
          <div class="form-group" id="subSubcategoryGroup" style="display:none">
            <label for="subSubcategoryId">Sub Subcategory</label>
            <select id="subSubcategoryId" name="subSubcategoryId" class="form-input">
              <option value="">Select Sub Subcategory</option>
            </select>
          </div>
          <div class="tab-nav-buttons">
            <button type="button" class="btn-next" onclick="goNext(0)">Next</button>
          </div>
        </div>

        <div id="tab-pricing" class="tab-pane">
          <div class="form-row">
            <div class="form-group">
              <label for="price">Price *</label>
              <input type="number" id="price" name="price" class="form-input" step="0.01" min="0" value="<%= isEditing ? product.price : '' %>" required>
            </div>
            <div class="form-group">
              <label for="comparePrice">Discount Price</label>
              <input type="number" id="comparePrice" name="comparePrice" class="form-input" step="0.01" min="0" value="<%= isEditing ? product.comparePrice : '' %>">
              <span class="form-hint">Optional. If set, original price will show with strikethrough</span>
            </div>
          </div>
          <div class="tab-nav-buttons">
            <button type="button" class="btn-prev" onclick="goPrev(1)">Previous</button>
            <button type="button" class="btn-next" onclick="goNext(1)">Next</button>
          </div>
        </div>

        <div id="tab-inventory" class="tab-pane">
          <div class="form-row">
            <div class="form-group">
              <label for="stock">Stock</label>
              <input type="number" id="stock" name="stock" class="form-input" min="0" value="<%= isEditing ? product.stock : 0 %>">
            </div>
            <div class="form-group">
              <label for="lowStockThreshold">Low Stock Threshold</label>
              <input type="number" id="lowStockThreshold" name="lowStockThreshold" class="form-input" min="0" value="<%= isEditing ? product.lowStockThreshold : 5 %>">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="minOrderQty">Min Order Quantity</label>
              <input type="number" id="minOrderQty" name="minOrderQty" class="form-input" min="1" value="<%= isEditing ? product.minOrderQty : 1 %>">
            </div>
            <div class="form-group">
              <label for="maxOrderQty">Max Order Quantity</label>
              <input type="number" id="maxOrderQty" name="maxOrderQty" class="form-input" min="1" value="<%= isEditing ? product.maxOrderQty : '' %>">
              <span class="form-hint">Leave empty for no limit</span>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="weight">Weight (kg) <span class="optional-badge">optional</span></label>
              <input type="number" id="weight" name="weight" class="form-input" step="0.01" min="0" value="<%= isEditing ? product.weight : '' %>">
            </div>
            <div class="form-group">
              <label for="dimensions">Dimensions (L x W x H cm) <span class="optional-badge">optional</span></label>
              <input type="text" id="dimensions" name="dimensions" class="form-input" value="<%= isEditing ? product.dimensions : '' %>" placeholder="e.g. 30 x 20 x 10">
            </div>
          </div>
          <div class="tab-nav-buttons">
            <button type="button" class="btn-prev" onclick="goPrev(2)">Previous</button>
            <button type="button" class="btn-next" onclick="goNext(2)">Next</button>
          </div>
        </div>

        <div id="tab-description" class="tab-pane">
          <div class="form-group">
            <label for="shortDescription">Short Description *</label>
            <textarea id="shortDescription" name="shortDescription" class="form-input" rows="3" required><%= isEditing ? product.shortDescription : '' %></textarea>
          </div>
          <div class="form-group">
            <label for="description">Full Description <span class="optional-badge">optional</span></label>
            <textarea id="description" name="description" class="rich-editor" rows="12"><%= isEditing ? product.description : '' %></textarea>
          </div>
          <div class="tab-nav-buttons">
            <button type="button" class="btn-prev" onclick="goPrev(3)">Previous</button>
            <button type="button" class="btn-next" onclick="goNext(3)">Next</button>
          </div>
        </div>

        <div id="tab-media" class="tab-pane">
          <div class="form-group">
            <label for="thumbnail">Thumbnail Image</label>
            <input type="file" id="thumbnail" name="thumbnail" class="form-input" accept="image/*" data-preview="thumbnailPreview">
            <div id="thumbnailPreview" class="image-preview">
              <% if (isEditing && product.thumbnail) { %>
                <div class="thumbnail-wrapper">
                  <img src="<%= product.thumbnail %>" alt="Current thumbnail">
                  <label class="form-check remove-check">
                    <input type="checkbox" name="removeThumbnail" value="1"> Remove thumbnail
                  </label>
                </div>
              <% } %>
            </div>
          </div>
          <div class="form-group">
            <label for="images">Additional Images</label>
            <input type="file" id="images" name="images" class="form-input" accept="image/*" multiple>
            <% if (isEditing && product.images && product.images.length > 0) { %>
            <div class="image-gallery image-gallery-sm">
              <% product.images.forEach(function(img) { %>
                <div class="gallery-item">
                  <img src="<%= img %>" alt="Product image">
                  <label class="form-check">
                    <input type="checkbox" name="removeImages" value="<%= img %>"> Remove
                  </label>
                </div>
              <% }) %>
            </div>
            <% } %>
          </div>
          <div class="tab-nav-buttons">
            <button type="button" class="btn-prev" onclick="goPrev(4)">Previous</button>
            <button type="button" class="btn-next" onclick="goNext(4)">Next</button>
          </div>
        </div>

        <div id="tab-attributes" class="tab-pane">
          <div class="form-group">
            <label for="shippingClass">Shipping</label>
            <select id="shippingClass" name="shippingClass" class="form-input">
              <option value="standard" <%= !isEditing || product.shippingClass == 'standard' ? 'selected' : '' %>>Standard Shipping - Rs. 200</option>
            </select>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="returnPolicy">Return Policy <span class="optional-badge">optional</span></label>
              <select id="returnPolicy" name="returnPolicy" class="form-input">
                <option value="">Store Default</option>
                <option value="30-days" <%= isEditing && product.returnPolicy == '30-days' ? 'selected' : '' %>>30 Days Return</option>
                <option value="7-days" <%= isEditing && product.returnPolicy == '7-days' ? 'selected' : '' %>>7 Days Return</option>
                <option value="no-return" <%= isEditing && product.returnPolicy == 'no-return' ? 'selected' : '' %>>No Returns</option>
              </select>
            </div>
            <div class="form-group">
              <label for="warranty">Warranty <span class="optional-badge">optional</span></label>
              <input type="text" id="warranty" name="warranty" class="form-input" value="<%= isEditing ? product.warranty : '' %>" placeholder="e.g. 1 Year Warranty">
            </div>
          </div>
          <div class="tab-nav-buttons">
            <button type="button" class="btn-prev" onclick="goPrev(5)">Previous</button>
            <button type="button" class="btn-next" onclick="goNext(5)">Next</button>
          </div>
        </div>

        <div id="tab-seo" class="tab-pane">
          <div class="form-group">
            <label for="metaTitle">Meta Title <span class="optional-badge">optional</span></label>
            <input type="text" id="metaTitle" name="metaTitle" class="form-input" value="<%= isEditing ? product.metaTitle : '' %>">
          </div>
          <div class="form-group">
            <label for="metaDescription">Meta Description <span class="optional-badge">optional</span></label>
            <textarea id="metaDescription" name="metaDescription" class="form-input" rows="4"><%= isEditing ? product.metaDescription : '' %></textarea>
          </div>
          <div class="form-group">
            <label for="seoKeywords">SEO Keywords <span class="optional-badge">optional</span></label>
            <input type="text" id="seoKeywords" name="seoKeywords" class="form-input" value="<%= isEditing ? product.seoKeywords : '' %>" placeholder="Comma separated">
            <span class="form-hint">Separate keywords with commas</span>
          </div>
          <div class="tab-nav-buttons">
            <button type="button" class="btn-prev" onclick="goPrev(6)">Previous</button>
            <button type="button" class="btn-next" onclick="goNext(6)">Next</button>
          </div>
        </div>

        <div id="tab-variants" class="tab-pane">
          <p class="form-hint">Optional. Add different variations of this product (e.g. different sizes, colors).</p>
          <div id="variantsContainer">
            <% if (isEditing && product.variants && product.variants.length > 0) { %>
              <% product.variants.forEach(function(variant, index) { %>
              <div class="variant-item">
                <div class="form-row">
                  <div class="form-group">
                    <label>Variant Name</label>
                    <input type="text" name="variants[<%= index %>][name]" class="form-input" value="<%= variant.name %>">
                  </div>
                  <div class="form-group">
                    <label>SKU</label>
                    <input type="text" name="variants[<%= index %>][sku]" class="form-input" value="<%= variant.sku %>">
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-group">
                    <label>Price</label>
                    <input type="number" name="variants[<%= index %>][price]" class="form-input" step="0.01" min="0" value="<%= variant.price %>">
                  </div>
                  <div class="form-group">
                    <label>Stock</label>
                    <input type="number" name="variants[<%= index %>][stock]" class="form-input" min="0" value="<%= variant.stock %>">
                  </div>
                </div>
                <button type="button" class="admin-btn admin-btn-danger admin-btn-sm remove-variant" onclick="this.parentElement.remove()">Remove</button>
                <hr>
              </div>
              <% }) %>
            <% } %>
          </div>
          <button type="button" class="admin-btn admin-btn-sm" onclick="addVariant()">Add Variant</button>
          <div class="tab-nav-buttons">
            <button type="button" class="btn-prev" onclick="goPrev(7)">Previous</button>
            <button type="button" class="btn-next" onclick="goNext(7)">Next</button>
          </div>
        </div>

        <div id="tab-specs" class="tab-pane">
          <p class="form-hint">Optional. Specifications are product details like Metal Type, Purity, Weight, etc. Add label-value pairs below.</p>
          <div id="specsContainer">
            <% if (isEditing && product.specifications && product.specifications.length > 0) { %>
              <% product.specifications.forEach(function(spec, index) { %>
              <div class="spec-item">
                <div class="form-row">
                  <div class="form-group">
                    <label>Label</label>
                    <input type="text" name="specifications[<%= index %>][label]" class="form-input" value="<%= spec.label %>">
                  </div>
                  <div class="form-group">
                    <label>Value</label>
                    <input type="text" name="specifications[<%= index %>][value]" class="form-input" value="<%= spec.value %>">
                  </div>
                </div>
                <button type="button" class="admin-btn admin-btn-danger admin-btn-sm" onclick="this.parentElement.remove()">Remove</button>
                <hr>
              </div>
              <% }) %>
            <% } %>
          </div>
          <button type="button" class="admin-btn admin-btn-sm" onclick="addSpec()">Add Specification</button>
          <div class="tab-nav-buttons">
            <button type="button" class="btn-prev" onclick="goPrev(8)">Previous</button>
          </div>
        </div>
      </div>

      <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--admin-border);display:flex;gap:10px;justify-content:flex-end">
        <button type="submit" class="btn-next" id="submitBtn" style="padding:12px 32px;font-size:0.9rem"><%= isEditing ? 'Update Product' : 'Create Product' %></button>
      </div>
    </form>
  </div>
</div>

<script>
  var totalTabs = 9;
  var currentTab = 0;
  var allCategories = <%- JSON.stringify(categories || []) %>;

  function showTab(index) {
    document.querySelectorAll('.tab-pane').forEach(function(p) { p.classList.remove('active'); });
    document.querySelectorAll('.tab-link').forEach(function(l) { l.classList.remove('active'); });
    document.getElementById('tab-' + ['basic','pricing','inventory','description','media','attributes','seo','variants','specs'][index]).classList.add('active');
    document.querySelector('.tab-link[data-index="' + index + '"]').classList.add('active');
    currentTab = index;
  }

  function getRequiredFields(tabIndex) {
    var tab = document.getElementById('tab-' + ['basic','pricing','inventory','description','media','attributes','seo','variants','specs'][tabIndex]);
    return tab ? tab.querySelectorAll('[required]') : [];
  }

  function validateTab(tabIndex) {
    var fields = getRequiredFields(tabIndex);
    for (var i = 0; i < fields.length; i++) {
      if (!fields[i].value.trim()) {
        return false;
      }
    }
    return true;
  }

  function goNext(tabIndex) {
    if (!validateTab(tabIndex)) {
      var btn = document.querySelector('.tab-pane.active .btn-next');
      if (btn) { btn.classList.add('shake'); setTimeout(function() { btn.classList.remove('shake'); }, 500); }
      return;
    }
    if (tabIndex < totalTabs - 1) {
      document.querySelector('.tab-link[data-index="' + tabIndex + '"]').classList.add('done');
      showTab(tabIndex + 1);
    }
  }

  function goPrev(tabIndex) {
    if (tabIndex > 0) showTab(tabIndex - 1);
  }

  function autoGenerateSlug(name) {
    if (!document.getElementById('slug').value || !<%= isEditing ? 'false' : 'true' %>) {
      document.getElementById('slug').value = name.toLowerCase()
        .replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    }
  }

  function loadSubcategories(catId) {
    var subGroup = document.getElementById('subcategoryGroup');
    var subSelect = document.getElementById('subcategoryId');
    var subSubGroup = document.getElementById('subSubcategoryGroup');
    var subSubSelect = document.getElementById('subSubcategoryId');
    subSubGroup.style.display = 'none';
    subSubSelect.innerHTML = '<option value="">Select Sub Subcategory</option>';
    if (!catId) { subGroup.style.display = 'none'; return; }
    var children = allCategories.filter(function(c) { return c.parentId == catId; });
    if (children.length === 0) { subGroup.style.display = 'none'; return; }
    subSelect.innerHTML = '<option value="">Select Subcategory</option>';
    children.forEach(function(c) { subSelect.innerHTML += '<option value="' + c.id + '">' + c.name + '</option>'; });
    subGroup.style.display = 'block';
  }

  function loadSubSubcategories(catId) {
    var subSubGroup = document.getElementById('subSubcategoryGroup');
    var subSubSelect = document.getElementById('subSubcategoryId');
    if (!catId) { subSubGroup.style.display = 'none'; return; }
    var children = allCategories.filter(function(c) { return c.parentId == catId; });
    if (children.length === 0) { subSubGroup.style.display = 'none'; return; }
    subSubSelect.innerHTML = '<option value="">Select Sub Subcategory</option>';
    children.forEach(function(c) { subSubSelect.innerHTML += '<option value="' + c.id + '">' + c.name + '</option>'; });
    subSubGroup.style.display = 'block';
  }

  <% if (isEditing && product.category) { %>
    (function() {
      var catId = <%= product.category %>;
      var cat = allCategories.find(function(c) { return c.id == catId; });
      if (cat && cat.parentId) {
        var parentSelect = document.getElementById('categoryId');
        parentSelect.value = cat.parentId;
        loadSubcategories(cat.parentId);
        setTimeout(function() {
          var subSelect = document.getElementById('subcategoryId');
          subSelect.value = catId;
          var hasDeeper = allCategories.some(function(c) { return c.parentId == catId; });
          if (hasDeeper) loadSubSubcategories(catId);
        }, 100);
      }
    })();
  <% } %>

  var variantIndex = <%= isEditing && product.variants ? product.variants.length : 0 %>;
  var specIndex = <%= isEditing && product.specifications ? product.specifications.length : 0 %>;

  function addVariant() {
    var container = document.getElementById('variantsContainer');
    var html = '<div class="variant-item">' +
      '<div class="form-row"><div class="form-group"><label>Variant Name</label><input type="text" name="variants[' + variantIndex + '][name]" class="form-input"></div><div class="form-group"><label>SKU</label><input type="text" name="variants[' + variantIndex + '][sku]" class="form-input"></div></div>' +
      '<div class="form-row"><div class="form-group"><label>Price</label><input type="number" name="variants[' + variantIndex + '][price]" class="form-input" step="0.01" min="0"></div><div class="form-group"><label>Stock</label><input type="number" name="variants[' + variantIndex + '][stock]" class="form-input" min="0"></div></div>' +
      '<button type="button" class="admin-btn admin-btn-danger admin-btn-sm" onclick="this.parentElement.remove()">Remove</button><hr></div>';
    container.insertAdjacentHTML('beforeend', html);
    variantIndex++;
  }

  function addSpec() {
    var container = document.getElementById('specsContainer');
    var html = '<div class="spec-item">' +
      '<div class="form-row"><div class="form-group"><label>Label</label><input type="text" name="specifications[' + specIndex + '][label]" class="form-input"></div><div class="form-group"><label>Value</label><input type="text" name="specifications[' + specIndex + '][value]" class="form-input"></div></div>' +
      '<button type="button" class="admin-btn admin-btn-danger admin-btn-sm" onclick="this.parentElement.remove()">Remove</button><hr></div>';
    container.insertAdjacentHTML('beforeend', html);
    specIndex++;
  }

  document.querySelectorAll('[data-preview]').forEach(function(input) {
    input.addEventListener('change', function() {
      var preview = document.getElementById(this.getAttribute('data-preview'));
      if (this.files && this.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) { preview.innerHTML = '<img src="' + e.target.result + '">'; };
        reader.readAsDataURL(this.files[0]);
      }
    });
  });

  document.getElementById('productForm').addEventListener('submit', function(e) {
    for (var i = 0; i < totalTabs - 1; i++) {
      if (!validateTab(i)) {
        e.preventDefault();
        showTab(i);
        var tab = document.querySelector('.tab-pane.active');
        if (tab) {
          tab.classList.add('shake');
          setTimeout(function() { tab.classList.remove('shake'); }, 500);
          tab.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        return;
      }
    }
  });
</script>

<%- include('../partials/footer') %>