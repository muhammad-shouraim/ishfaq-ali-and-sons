<%- include('../partials/header') %>

<div class="page-header">
  <h1 class="page-title">Customer: <%= customer.name %></h1>
  <a href="<%= adminPath %>/customers" class="admin-btn">Back to Customers</a>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <div class="customer-info-grid">
      <div class="customer-avatar">
        <i class="fas fa-user-circle fa-5x"></i>
      </div>
      <div class="customer-details">
        <table class="info-table">
          <tr><td>Name</td><td><strong><%= customer.name %></strong></td></tr>
          <tr><td>Email</td><td><%= customer.email %></td></tr>
          <tr><td>Phone</td><td><%= customer.phone || '-' %></td></tr>
          <tr><td>Role</td><td><%= customer.role || 'customer' %></td></tr>
          <tr><td>Status</td><td>
            <% if (customer.isBlocked) { %>
              <span class="admin-badge admin-badge-danger">Blocked</span>
            <% } else { %>
              <span class="admin-badge admin-badge-success">Active</span>
            <% } %>
          </td></tr>
          <tr><td>Registered</td><td><%= new Date(customer.createdAt).toLocaleDateString() %></td></tr>
          <tr><td>Total Spent</td><td>Rs. <%= (typeof totalSpent !== 'undefined' ? totalSpent : 0).toLocaleString() %></td></tr>
          <tr><td>Orders</td><td><%= typeof totalOrders !== 'undefined' ? totalOrders : 0 %></td></tr>
          <tr><td>Tags</td><td><%= customer.tags || '-' %></td></tr>
        </table>
      </div>
      <div class="customer-actions">
        <form action="<%= adminPath %>/customers/<%= customer.id %>/block" method="POST" style="display:inline" data-confirm="Are you sure you want to <%= customer.isBlocked ? 'unblock' : 'block' %> this customer?">
          <button type="submit" class="admin-btn <%= customer.isBlocked ? 'admin-btn-primary' : 'admin-btn-danger' %>">
            <i class="fas fa-<%= customer.isBlocked ? 'check-circle' : 'ban' %>"></i>
            <%= customer.isBlocked ? 'Unblock' : 'Block' %> Customer
          </button>
        </form>
        <% if (user.role === 'super_admin') { %>
        <form action="<%= adminPath %>/customers/<%= customer.id %>/delete" method="POST" style="display:inline" data-confirm="Are you sure you want to delete this customer? This action cannot be undone.">
          <button type="submit" class="admin-btn admin-btn-danger">
            <i class="fas fa-trash"></i> Delete Customer
          </button>
        </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Internal Notes (Staff Only)</h3>
    </div>
    <div class="admin-card-body">
      <form id="customerNotesForm" class="admin-form">
        <div class="form-group">
          <textarea name="notes" class="form-input" rows="4" placeholder="Internal notes about this customer..."><%= customer.internalNotes || '' %></textarea>
        </div>
        <button type="submit" class="admin-btn admin-btn-primary">Save Notes</button>
        <span id="notesStatus" class="text-muted" style="margin-left:10px"></span>
      </form>
    </div>
  </div>
  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Tags</h3>
    </div>
    <div class="admin-card-body">
      <form id="customerTagsForm" class="admin-form">
        <div class="form-group">
          <input type="text" name="tags" class="form-input" placeholder="VIP, Wholesale, etc. (comma separated)" value="<%= customer.tags || '' %>">
        </div>
        <button type="submit" class="admin-btn admin-btn-primary">Save Tags</button>
        <span id="tagsStatus" class="text-muted" style="margin-left:10px"></span>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('customerNotesForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var notes = this.querySelector('[name="notes"]').value;
  var status = document.getElementById('notesStatus');
  status.textContent = 'Saving...';
  fetch('<%= adminPath %>/customers/<%= customer.id %>/notes', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ notes: notes })
  }).then(function(r) { return r.json(); }).then(function(data) {
    status.textContent = data.success ? 'Saved!' : 'Error';
    if (data.success) setTimeout(function() { status.textContent = ''; }, 2000);
  }).catch(function() { status.textContent = 'Error'; });
});
document.getElementById('customerTagsForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var tags = this.querySelector('[name="tags"]').value;
  var status = document.getElementById('tagsStatus');
  status.textContent = 'Saving...';
  fetch('<%= adminPath %>/customers/<%= customer.id %>/tags', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ tags: tags })
  }).then(function(r) { return r.json(); }).then(function(data) {
    status.textContent = data.success ? 'Saved!' : 'Error';
    if (data.success) setTimeout(function() { status.textContent = ''; }, 2000);
  }).catch(function() { status.textContent = 'Error'; });
});
</script>

<div class="grid-2">
  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Orders (<%= (customer.orders || []).length %>)</h3>
    </div>
    <div class="admin-card-body">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Order #</th>
            <th>Total</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (customer.orders && customer.orders.length > 0) { %>
            <% customer.orders.forEach(function(order) { %>
            <tr>
              <td><a href="<%= adminPath %>/orders/<%= order.id %>">#<%= order.orderNumber %></a></td>
              <td>Rs. <%= (order.total || 0).toLocaleString() %></td>
              <td>
                <% var sClass = { pending: 'admin-badge-warning', processing: 'admin-badge-info', shipped: 'admin-badge-primary', delivered: 'admin-badge-success', cancelled: 'admin-badge-danger' } %>
                <span class="admin-badge <%= sClass[order.orderStatus] || 'admin-badge-secondary' %>"><%= order.orderStatus || order.status %></span>
              </td>
              <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="4" class="text-center">No orders yet</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Wishlist (<%= (customer.wishlist || []).length %>)</h3>
    </div>
    <div class="admin-card-body">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          <% if (customer.wishlist && customer.wishlist.length > 0) { %>
            <% customer.wishlist.forEach(function(item) { %>
            <tr>
              <td><%= item.productName %></td>
              <td>$<%= (item.price || 0).toFixed(2) %></td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="2" class="text-center">No wishlist items</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Reviews (<%= (customer.reviews || []).length %>)</h3>
    </div>
    <div class="admin-card-body">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Rating</th>
            <th>Review</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (customer.reviews && customer.reviews.length > 0) { %>
            <% customer.reviews.forEach(function(review) { %>
            <tr>
              <td><%= review.productName %></td>
              <td>
                <% for (var i = 1; i <= 5; i++) { %>
                  <i class="fas fa-star <%= i <= review.rating ? 'text-warning' : 'text-muted' %>"></i>
                <% } %>
              </td>
              <td><%= review.comment ? review.comment.substring(0, 50) + '...' : '-' %></td>
              <td><%= new Date(review.createdAt).toLocaleDateString() %></td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="4" class="text-center">No reviews yet</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Activity Log</h3>
    </div>
    <div class="admin-card-body">
      <div class="activity-log">
        <% if (typeof activityLogs !== 'undefined' && activityLogs.length > 0) { %>
          <% activityLogs.forEach(function(log) { %>
          <div class="activity-item">
            <i class="fas fa-circle activity-dot"></i>
            <div class="activity-content">
              <p><%= log.description %></p>
              <span class="activity-date"><%= new Date(log.createdAt).toLocaleString() %></span>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <p class="text-center">No activity recorded</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-confirm]').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      if (!confirm(this.getAttribute('data-confirm'))) {
        e.preventDefault();
      }
    });
  });
</script>

<%- include('../partials/footer') %>