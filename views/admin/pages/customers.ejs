<%- include('../partials/header') %>

<div class="page-header">
  <h1 class="page-title">Customers</h1>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <form action="<%= adminPath %>/customers" method="GET" class="admin-search">
      <i class="fas fa-search"></i>
      <input type="text" name="search" placeholder="Search customers..." value="<%= search || '' %>">
    </form>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Role</th>
          <th>Orders</th>
          <th>Total Spent (PKR)</th>
          <th>Tags</th>
          <th>Status</th>
          <th>Registered</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
          <% customers.forEach(function(customer) { %>
          <tr>
            <td><a href="<%= adminPath %>/customers/<%= customer.id %>"><%= customer.name %></a></td>
            <td><%= customer.email %></td>
            <td><%= customer.phone || '-' %></td>
            <td><%= customer.role || 'customer' %></td>
            <td><%= customer.ordersCount || 0 %></td>
            <td>Rs. <%= (customer.totalSpent || 0).toLocaleString() %></td>
            <td><%= customer.tags || '-' %></td>
            <td>
              <% if (customer.isBlocked) { %>
                <span class="admin-badge admin-badge-danger">Blocked</span>
              <% } else { %>
                <span class="admin-badge admin-badge-success">Active</span>
              <% } %>
            </td>
            <td><%= new Date(customer.createdAt).toLocaleDateString() %></td>
            <td>
              <a href="<%= adminPath %>/customers/<%= customer.id %>" class="admin-btn admin-btn-sm" title="View"><i class="fas fa-eye"></i></a>
              <form action="<%= adminPath %>/customers/<%= customer.id %>/block" method="POST" style="display:inline" data-confirm="Are you sure you want to <%= customer.isBlocked ? 'unblock' : 'block' %> this customer?">
                <button type="submit" class="admin-btn admin-btn-sm" title="<%= customer.isBlocked ? 'Unblock' : 'Block' %>">
                  <i class="fas fa-<%= customer.isBlocked ? 'check-circle' : 'ban' %>"></i>
                </button>
              </form>
              <% if (user.role === 'super_admin') { %>
              <form action="<%= adminPath %>/customers/<%= customer.id %>/delete" method="POST" style="display:inline" data-confirm="Are you sure you want to delete this customer? This action cannot be undone.">
                <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm" title="Delete"><i class="fas fa-trash"></i></button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="10" class="text-center">No customers found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<% if (typeof pages !== 'undefined' && pages > 1) { %>
<div class="admin-pagination">
  <span>Page <%= currentPage %> of <%= pages %></span>
  <div class="pagination-links">
    <% if (currentPage > 1) { %>
      <a href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>" class="admin-btn admin-btn-sm">&laquo; Prev</a>
    <% } %>
    <% for (var i = 1; i <= pages; i++) { %>
      <a href="?page=<%= i %>&search=<%= search || '' %>" class="admin-btn admin-btn-sm <%= currentPage == i ? 'admin-btn-primary' : '' %>"><%= i %></a>
    <% } %>
    <% if (currentPage < pages) { %>
      <a href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>" class="admin-btn admin-btn-sm">Next &raquo;</a>
    <% } %>
  </div>
</div>
<% } %>

<script>
  document.querySelectorAll('[data-confirm]').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      if (!confirm(this.getAttribute('data-confirm'))) {
        e.preventDefault();
      }
    });
  });
</script>

<%- include('../partials/footer') %>