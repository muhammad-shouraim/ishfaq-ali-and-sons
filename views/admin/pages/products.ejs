<%- include('../partials/header') %>

<div class="page-header">
  <h1 class="page-title">Products</h1>
  <a href="<%= adminPath %>/products/create" class="admin-btn admin-btn-primary">Add Product</a>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <div class="toolbar">
      <div class="toolbar-left">
        <form action="<%= adminPath %>/products" method="GET" class="admin-search">
          <i class="fas fa-search"></i>
          <input type="text" name="search" placeholder="Search products..." value="<%= search || '' %>">
        </form>
        <select name="category" form="filterForm" class="form-input" onchange="this.form.submit()">
          <option value="">All Categories</option>
          <% if (typeof categories !== 'undefined') { %>
            <% categories.forEach(function(cat) { %>
            <option value="<%= cat.id %>" <%= filterCategory == cat.id ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="toolbar-right">
        <form id="bulkForm" action="<%= adminPath %>/products/bulk" method="POST">
          <select name="action" class="form-input" required>
            <option value="">Bulk Actions</option>
            <option value="delete">Delete</option>
            <option value="activate">Activate</option>
            <option value="deactivate">Deactivate</option>
            <option value="feature">Feature</option>
            <option value="unfeature">Unfeature</option>
            <option value="change_category">Change Category</option>
            <option value="price_adjust">Price Adjust %</option>
          </select>
          <input type="number" name="value" class="form-input" placeholder="Category ID or %" style="width:80px;display:none" id="bulkValue">
          <button type="submit" class="admin-btn admin-btn-sm">Apply</button>
        </form>
      </div>
    </div>

    <form id="filterForm" action="<%= adminPath %>/products" method="GET">
      <input type="hidden" name="search" value="<%= search || '' %>">
      <input type="hidden" name="category" value="<%= filterCategory || '' %>">
    </form>
  </div>
</div>

<script>
document.querySelector('[name="action"]').addEventListener('change', function() {
  var val = document.getElementById('bulkValue');
  val.style.display = this.value === 'change_category' || this.value === 'price_adjust' ? 'inline-block' : 'none';
});
</script>

<div class="admin-card">
  <div class="admin-card-body">
    <table class="admin-table">
      <thead>
        <tr>
          <th width="40"><input type="checkbox" id="selectAll"></th>
          <th width="50">Image</th>
          <th>Name</th>
          <th>SKU</th>
          <th>Category</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Status</th>
          <th width="200">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof products !== 'undefined' && products.length > 0) { %>
          <% products.forEach(function(product) { %>
          <tr class="<%= product.stock <= (typeof lowStockThreshold !== 'undefined' ? lowStockThreshold : 5) ? 'low-stock-row' : '' %>">
            <td><input type="checkbox" name="ids" form="bulkForm" value="<%= product.id %>" class="select-item"></td>
            <td>
              <% if (product.thumbnail) { %>
                <img src="<%= product.thumbnail %>" alt="<%= product.name %>" class="product-thumb">
              <% } else { %>
                <i class="fas fa-gem"></i>
              <% } %>
            </td>
            <td><a href="<%= adminPath %>/products/edit/<%= product.id %>"><%= product.name %></a></td>
            <td><%= product.sku || '-' %></td>
            <td><%= product.categoryData ? product.categoryData.name : '-' %></td>
            <td>Rs. <%= (product.price || 0).toLocaleString() %></td>
            <td>
              <% if (product.stock <= 0) { %>
                <span class="admin-badge admin-badge-danger">Out of Stock</span>
              <% } else if (product.stock <= (product.lowStockThreshold || 5)) { %>
                <span class="admin-badge admin-badge-warning"><%= product.stock %></span>
              <% } else { %>
                <span><%= product.stock %></span>
              <% } %>
            </td>
            <td>
              <% var badgeClass = product.isActive ? 'admin-badge-success' : 'admin-badge-secondary' %>
              <span class="admin-badge <%= badgeClass %>"><%= product.isActive ? 'Active' : 'Inactive' %></span>
            </td>
            <td>
              <a href="<%= adminPath %>/products/edit/<%= product.id %>" class="admin-btn admin-btn-sm" title="Edit"><i class="fas fa-edit"></i></a>
              <form action="<%= adminPath %>/products/<%= product.id %>/duplicate" method="POST" style="display:inline">
                <button type="submit" class="admin-btn admin-btn-sm" title="Duplicate"><i class="fas fa-copy"></i></button>
              </form>
              <form action="<%= adminPath %>/products/<%= product.id %>/toggle-status" method="POST" style="display:inline">
                <button type="submit" class="admin-btn admin-btn-sm" title="Toggle Status"><i class="fas fa-power-off"></i></button>
              </form>
              <form action="<%= adminPath %>/products/delete/<%= product.id %>" method="POST" style="display:inline" data-confirm="Are you sure you want to delete this product?">
                <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm" title="Delete"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="9" class="text-center">No products found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<% if (typeof pages !== 'undefined' && pages > 1) { %>
<div class="admin-pagination">
  <span>Page <%= currentPage %> of <%= pages %></span>
  <div class="pagination-links">
    <% if (currentPage > 1) { %>
      <a href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>&category=<%= filterCategory || '' %>" class="admin-btn admin-btn-sm">&laquo; Prev</a>
    <% } %>
    <% for (var i = 1; i <= pages; i++) { %>
      <a href="?page=<%= i %>&search=<%= search || '' %>&category=<%= filterCategory || '' %>" class="admin-btn admin-btn-sm <%= currentPage == i ? 'admin-btn-primary' : '' %>"><%= i %></a>
    <% } %>
    <% if (currentPage < pages) { %>
      <a href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>&category=<%= filterCategory || '' %>" class="admin-btn admin-btn-sm">Next &raquo;</a>
    <% } %>
  </div>
</div>
<% } %>

<script>
  document.getElementById('selectAll').addEventListener('change', function() {
    document.querySelectorAll('.select-item').forEach(function(cb) {
      cb.checked = this.checked;
    }, this);
  });

  document.querySelectorAll('[data-confirm]').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      if (!confirm(this.getAttribute('data-confirm'))) {
        e.preventDefault();
      }
    });
  });
</script>

<%- include('../partials/footer') %>