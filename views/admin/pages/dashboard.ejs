<%- include('../partials/header') %>

<div class="dashboard">
  <div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Welcome back, <%= user.name %></p>
  </div>

  <div class="stats-grid">
    <div class="admin-card stat-card">
      <div class="stat-icon stat-icon-primary">
        <i class="fas fa-box"></i>
      </div>
      <div class="stat-content">
        <span class="stat-value"><%= totalProducts || 0 %></span>
        <span class="stat-label">Total Products</span>
      </div>
    </div>
    <div class="admin-card stat-card">
      <div class="stat-icon stat-icon-info">
        <i class="fas fa-tags"></i>
      </div>
      <div class="stat-content">
        <span class="stat-value"><%= totalCategories || 0 %></span>
        <span class="stat-label">Total Categories</span>
      </div>
    </div>
    <div class="admin-card stat-card">
      <div class="stat-icon stat-icon-warning">
        <i class="fas fa-shopping-cart"></i>
      </div>
      <div class="stat-content">
        <span class="stat-value"><%= totalOrders || 0 %></span>
        <span class="stat-label">Total Orders</span>
      </div>
    </div>
    <div class="admin-card stat-card">
      <div class="stat-icon stat-icon-success">
        <i class="fas fa-users"></i>
      </div>
      <div class="stat-content">
        <span class="stat-value"><%= totalCustomers || 0 %></span>
        <span class="stat-label">Total Customers</span>
      </div>
    </div>
    <div class="admin-card stat-card">
      <div class="stat-icon stat-icon-primary">
        <i class="fas fa-dollar-sign"></i>
      </div>
      <div class="stat-content">
        <span class="stat-value">Rs. <%= (totalRevenue || 0).toLocaleString() %></span>
        <span class="stat-label">Total Revenue</span>
      </div>
    </div>
    <div class="admin-card stat-card">
      <div class="stat-icon stat-icon-danger">
        <i class="fas fa-clock"></i>
      </div>
      <div class="stat-content">
        <span class="stat-value"><%= pendingOrders || 0 %></span>
        <span class="stat-label">Pending Orders</span>
      </div>
    </div>
  </div>

  <% if (typeof lowStockProducts !== 'undefined' && lowStockProducts.length > 0) { %>
  <div class="admin-card alert-card">
    <div class="alert-card-header">
      <i class="fas fa-exclamation-triangle text-warning"></i>
      <h3>Low Stock Alert (<%= lowStockProducts.length %>)</h3>
    </div>
    <div class="alert-card-body">
      <table class="admin-table">
        <thead>
          <tr><th>Product</th><th>Stock</th><th>Action</th></tr>
        </thead>
        <tbody>
          <% lowStockProducts.forEach(function(product) { %>
          <tr>
            <td><a href="<%= adminPath %>/products/edit/<%= product.id %>"><%= product.name %></a></td>
            <td><span class="admin-badge admin-badge-danger"><%= product.stock %></span></td>
            <td><a href="<%= adminPath %>/products/edit/<%= product.id %>" class="admin-btn admin-btn-sm">Restock</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } else if (typeof lowStockCount !== 'undefined') { %>
  <div class="admin-card alert-card">
    <div class="alert-card-header">
      <i class="fas fa-check-circle text-success"></i>
      <h3>Inventory Status</h3>
    </div>
    <div class="alert-card-body">
      <p>All products are well-stocked. <a href="<%= adminPath %>/products">View Products</a></p>
    </div>
  </div>
  <% } %>

  <div class="grid-2">
    <div class="admin-card">
      <div class="admin-card-header">
        <h3>Revenue Overview</h3>
        <div>
          <select id="revenueRange" class="form-input" style="width:auto;display:inline-block" onchange="loadRevenueChart()">
            <option value="7">Last 7 Days</option>
            <option value="30" selected>Last 30 Days</option>
            <option value="90">Last 90 Days</option>
            <option value="365">This Year</option>
          </select>
        </div>
      </div>
      <div class="admin-card-body">
        <canvas id="revenueChart" height="250"></canvas>
      </div>
    </div>
    <div class="admin-card">
      <div class="admin-card-header">
        <h3>Top Selling Products</h3>
        <div>
          <select id="topSellingRange" class="form-input" style="width:auto;display:inline-block" onchange="loadTopSelling()">
            <option value="7">7 Days</option>
            <option value="30" selected>30 Days</option>
            <option value="90">90 Days</option>
          </select>
        </div>
      </div>
      <div class="admin-card-body" id="topSellingContainer">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Sold</th>
              <th>Revenue</th>
            </tr>
          </thead>
          <tbody id="topSellingBody">
            <tr><td colspan="3" class="text-center">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Recent Activity</h3>
    </div>
    <div class="admin-card-body">
      <div class="activity-log" id="activityLogContainer">
        <% if (typeof recentActivity !== 'undefined' && recentActivity.length > 0) { %>
          <% recentActivity.forEach(function(log) { %>
          <div class="activity-item">
            <i class="fas fa-circle activity-dot"></i>
            <div class="activity-content">
              <p><%= log.description %></p>
              <span class="activity-date"><%= new Date(log.createdAt).toLocaleString() %></span>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <p class="text-center">No recent activity</p>
        <% } %>
      </div>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Recent Orders</h3>
      <a href="<%= adminPath %>/orders" class="admin-btn admin-btn-sm">View All</a>
    </div>
    <div class="admin-card-body">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Order #</th>
            <th>Customer</th>
            <th>Items</th>
            <th>Total</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof recentOrders !== 'undefined') { %>
            <% recentOrders.forEach(function(order) { %>
            <tr>
              <td><a href="<%= adminPath %>/orders/<%= order.id %>">#<%= order.orderNumber %></a></td>
              <td><%= order.customerName %></td>
              <td><%= order.itemsCount %></td>
              <td>Rs. <%= (order.total || 0).toLocaleString() %></td>
              <td>
                <% var statusClass = { pending: 'admin-badge-warning', processing: 'admin-badge-info', shipped: 'admin-badge-primary', delivered: 'admin-badge-success', cancelled: 'admin-badge-danger' } %>
                <span class="admin-badge <%= statusClass[order.orderStatus] || 'admin-badge-secondary' %>"><%= order.orderStatus %></span>
              </td>
              <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6" class="text-center">No recent orders</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
var revenueChart = null;

function loadRevenueChart() {
  var days = document.getElementById('revenueRange').value;
  fetch('<%= adminPath %>/api/revenue-data?days=' + days)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (revenueChart) revenueChart.destroy();
      var ctx = document.getElementById('revenueChart').getContext('2d');
      revenueChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: data.labels || [],
          datasets: [{
            label: 'Revenue',
            data: data.values || [],
            borderColor: '#D4AF37',
            backgroundColor: 'rgba(212, 175, 55, 0.1)',
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { callback: function(v) { return 'Rs.' + v.toLocaleString(); } } } }
        }
      });
    });
}

function loadTopSelling() {
  var days = document.getElementById('topSellingRange').value;
  fetch('<%= adminPath %>/api/top-selling?days=' + days)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var tbody = document.getElementById('topSellingBody');
      if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" class="text-center">No sales in this period</td></tr>';
        return;
      }
      tbody.innerHTML = data.map(function(p) {
        return '<tr><td>' + p.name + '</td><td>' + p.sold + '</td><td>Rs. ' + Number(p.revenue || 0).toLocaleString() + '</td></tr>';
      }).join('');
    });
}

document.addEventListener('DOMContentLoaded', function() {
  loadRevenueChart();
  loadTopSelling();
});
</script>

<%- include('../partials/footer') %>