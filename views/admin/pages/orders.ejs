<%- include('../partials/header') %>

<div class="page-header">
  <h1 class="page-title">Orders</h1>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <form action="<%= adminPath %>/orders" method="GET" class="filter-form">
      <div class="form-row">
        <div class="form-group">
          <label for="status">Status</label>
          <select id="status" name="status" class="form-input" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="pending" <%= filterStatus == 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="processing" <%= filterStatus == 'processing' ? 'selected' : '' %>>Processing</option>
            <option value="shipped" <%= filterStatus == 'shipped' ? 'selected' : '' %>>Shipped</option>
            <option value="delivered" <%= filterStatus == 'delivered' ? 'selected' : '' %>>Delivered</option>
            <option value="cancelled" <%= filterStatus == 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            <option value="refunded" <%= filterStatus == 'refunded' ? 'selected' : '' %>>Refunded</option>
          </select>
        </div>
        <div class="form-group">
          <label for="dateFrom">From</label>
          <input type="date" id="dateFrom" name="dateFrom" class="form-input" value="<%= filterDateFrom || '' %>">
        </div>
        <div class="form-group">
          <label for="dateTo">To</label>
          <input type="date" id="dateTo" name="dateTo" class="form-input" value="<%= filterDateTo || '' %>">
        </div>
        <div class="form-group">
          <label for="search">Search</label>
          <input type="text" id="search" name="search" class="form-input" placeholder="Order # or customer..." value="<%= search || '' %>">
        </div>
        <div class="form-group" style="align-self:flex-end">
          <button type="submit" class="admin-btn admin-btn-primary">Filter</button>
          <a href="<%= adminPath %>/orders" class="admin-btn">Reset</a>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <form id="bulkOrderForm" action="<%= adminPath %>/orders/bulk-status" method="POST">
      <div class="toolbar" style="margin-bottom:15px">
        <div class="toolbar-left">
          <span id="selectedCount" class="text-muted">0 selected</span>
        </div>
        <div class="toolbar-right">
          <select name="status" class="form-input" style="width:auto;display:inline-block" required>
            <option value="">Bulk Status</option>
            <option value="confirmed">Confirmed</option>
            <option value="processing">Processing</option>
            <option value="shipped">Shipped</option>
            <option value="delivered">Delivered</option>
            <option value="cancelled">Cancelled</option>
          </select>
          <button type="submit" class="admin-btn admin-btn-sm" onclick="return confirm('Update selected orders?')">Apply</button>
        </div>
      </div>
    </form>
    <table class="admin-table">
      <thead>
        <tr>
          <th width="40"><input type="checkbox" id="selectAllOrders"></th>
          <th>Order #</th>
          <th>Customer</th>
          <th>Total</th>
          <th>Payment</th>
          <th>Payment Status</th>
          <th>Order Status</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
          <% orders.forEach(function(order) { %>
          <tr>
            <td><input type="checkbox" name="ids" form="bulkOrderForm" value="<%= order.id %>" class="order-select"></td>
            <td><a href="<%= adminPath %>/orders/<%= order.id %>">#<%= order.orderNumber %></a></td>
            <td><%= order.customerName %></td>
            <td>Rs. <%= (order.total || 0).toLocaleString() %></td>
            <td><%= order.paymentMethod || '-' %></td>
            <td>
              <% var pClass = { paid: 'admin-badge-success', pending: 'admin-badge-warning', failed: 'admin-badge-danger', refunded: 'admin-badge-info' } %>
              <span class="admin-badge <%= pClass[order.paymentStatus] || 'admin-badge-secondary' %>"><%= order.paymentStatus || 'pending' %></span>
            </td>
            <td>
              <% var sClass = { pending: 'admin-badge-warning', processing: 'admin-badge-info', shipped: 'admin-badge-primary', delivered: 'admin-badge-success', cancelled: 'admin-badge-danger', refunded: 'admin-badge-secondary' } %>
              <span class="admin-badge <%= sClass[order.orderStatus] || 'admin-badge-secondary' %>"><%= order.orderStatus %></span>
            </td>
            <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
            <td>
              <a href="<%= adminPath %>/orders/<%= order.id %>" class="admin-btn admin-btn-sm" title="View"><i class="fas fa-eye"></i></a>
              <a href="<%= adminPath %>/orders/<%= order.id %>/invoice" class="admin-btn admin-btn-sm" title="Invoice" target="_blank"><i class="fas fa-file-invoice"></i></a>
              <a href="<%= adminPath %>/orders/<%= order.id %>/packing-slip" class="admin-btn admin-btn-sm" title="Packing Slip" target="_blank"><i class="fas fa-truck"></i></a>
              <form action="<%= adminPath %>/orders/<%= order.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this order?')">
                <button type="submit" class="admin-btn admin-btn-sm admin-btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="9" class="text-center">No orders found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
document.getElementById('selectAllOrders').addEventListener('change', function() {
  document.querySelectorAll('.order-select').forEach(function(cb) { cb.checked = this.checked; }, this);
  updateOrderCount();
});
document.querySelectorAll('.order-select').forEach(function(cb) {
  cb.addEventListener('change', updateOrderCount);
});
function updateOrderCount() {
  var n = document.querySelectorAll('.order-select:checked').length;
  document.getElementById('selectedCount').textContent = n + ' selected';
}
</script>

<% if (typeof pages !== 'undefined' && pages > 1) { %>
<div class="admin-pagination">
  <span>Page <%= currentPage %> of <%= pages %></span>
  <div class="pagination-links">
    <% if (currentPage > 1) { %>
      <a href="?page=<%= currentPage - 1 %>&status=<%= filterStatus || '' %>&search=<%= search || '' %>&dateFrom=<%= filterDateFrom || '' %>&dateTo=<%= filterDateTo || '' %>" class="admin-btn admin-btn-sm">&laquo; Prev</a>
    <% } %>
    <% for (var i = 1; i <= pages; i++) { %>
      <a href="?page=<%= i %>&status=<%= filterStatus || '' %>&search=<%= search || '' %>&dateFrom=<%= filterDateFrom || '' %>&dateTo=<%= filterDateTo || '' %>" class="admin-btn admin-btn-sm <%= currentPage == i ? 'admin-btn-primary' : '' %>"><%= i %></a>
    <% } %>
    <% if (currentPage < pages) { %>
      <a href="?page=<%= currentPage + 1 %>&status=<%= filterStatus || '' %>&search=<%= search || '' %>&dateFrom=<%= filterDateFrom || '' %>&dateTo=<%= filterDateTo || '' %>" class="admin-btn admin-btn-sm">Next &raquo;</a>
    <% } %>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>