<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Packing Slip - <%= order.orderNumber %></title>
  <style>
    body { font-family: 'Courier New', monospace; font-size: 12px; margin: 20px; color: #000; }
    .header { text-align: center; border-bottom: 2px dashed #000; padding-bottom: 10px; margin-bottom: 20px; }
    .header h1 { margin: 0; font-size: 20px; }
    .header p { margin: 5px 0; }
    table { width: 100%; border-collapse: collapse; margin: 10px 0; }
    th, td { border: 1px solid #000; padding: 6px 8px; text-align: left; }
    th { background: #eee; }
    .totals { margin-top: 20px; text-align: right; }
    .footer { position: fixed; bottom: 20px; text-align: center; font-size: 10px; color: #666; }
    .print-btn { text-align: center; margin: 20px 0; }
    @media print { .print-btn { display: none; } }
  </style>
</head>
<body>
  <div class="print-btn">
    <button onclick="window.print()">Print</button>
    <button onclick="window.close()">Close</button>
  </div>
  <div class="header">
    <h1>PACKING SLIP</h1>
    <p><strong>Order #<%= order.orderNumber %></strong></p>
    <p>Date: <%= new Date(order.createdAt).toLocaleDateString() %></p>
  </div>

  <h3>Ship To:</h3>
  <p><%= shipping.name || shipping.fullName || '' %></p>
  <p><%= shipping.address || shipping.street || '' %></p>
  <p><%= shipping.city || '' %>, <%= shipping.state || '' %> <%= shipping.zip || shipping.postalCode || '' %></p>
  <p>Phone: <%= shipping.phone || '' %></p>

  <h3>Items:</h3>
  <table>
    <thead>
      <tr>
        <th>Qty</th>
        <th>Item</th>
        <th>SKU</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) { %>
      <tr>
        <td><%= item.quantity %></td>
        <td><%= item.productName %></td>
        <td><%= item.sku || '-' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="footer">
    Packing Slip - Ishfaq Ali &amp; Sons - <%= new Date().toLocaleDateString() %>
  </div>
</body>
</html>
