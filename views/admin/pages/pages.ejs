<%- include('../partials/header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3>All Pages</h3>
    <a href="<%= adminPath %>/pages/create" class="admin-btn admin-btn-primary"><i class="fas fa-plus"></i> New Page</a>
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Slug</th>
          <th>Status</th>
          <th>Updated</th>
          <th class="actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (pages && pages.length) { %>
          <% pages.forEach(function(page) { %>
            <tr>
              <td><%= page.title %></td>
              <td><code>/<%= page.slug %></code></td>
              <td>
                <% if (page.status === 'published') { %>
                  <span class="admin-badge admin-badge-success">Published</span>
                <% } else if (page.status === 'draft') { %>
                  <span class="admin-badge admin-badge-secondary">Draft</span>
                <% } else if (page.status === 'scheduled') { %>
                  <span class="admin-badge admin-badge-info">Scheduled</span>
                <% } else { %>
                  <span class="admin-badge admin-badge-secondary"><%= page.status %></span>
                <% } %>
              </td>
              <td><%= page.updatedAt ? new Date(page.updatedAt).toLocaleDateString() : '' %></td>
              <td>
                <div class="actions">
                  <a href="<%= adminPath %>/pages/edit/<%= page.id %>" class="admin-btn admin-btn-outline admin-btn-sm"><i class="fas fa-edit"></i> Edit</a>
                  <form action="<%= adminPath %>/pages/<%= page.id %>/delete" method="POST" style="display:inline" data-confirm="Are you sure you want to delete this page? This cannot be undone.">
                    <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm"><i class="fas fa-trash"></i> Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
        <% var corePages = [
          { title: 'Home', slug: 'home' },
          { title: 'Shop', slug: 'shop' },
          { title: 'Product Detail', slug: 'product-detail' },
          { title: 'Categories / Collection', slug: 'collection' },
          { title: 'Cart', slug: 'cart' },
          { title: 'Checkout', slug: 'checkout' },
          { title: 'Order Success', slug: 'order-success' },
          { title: 'My Orders', slug: 'orders' },
          { title: 'Profile', slug: 'profile' },
          { title: 'Wishlist', slug: 'wishlist' },
          { title: 'Search', slug: 'search' },
          { title: 'Login', slug: 'login' },
          { title: 'Signup', slug: 'signup' },
          { title: 'Forgot Password', slug: 'forgot-password' },
          { title: '404 Page', slug: '404' },
          { title: 'About Us', slug: 'about-us' },
          { title: 'Privacy Policy', slug: 'privacy-policy' },
          { title: 'Refund Policy', slug: 'refund-policy' },
          { title: 'Shipping Policy', slug: 'shipping-policy' },
          { title: 'Terms & Conditions', slug: 'terms-conditions' },
          { title: 'Contact Us', slug: 'contact-us' },
          { title: 'Track Order', slug: 'track-order' }
        ]; %>
        <% corePages.forEach(function(p) { %>
          <% var dbPage = pages && pages.find(function(dp) { return dp.slug === p.slug; }); %>
          <tr>
            <td><%= p.title %></td>
            <td><code>/<%= p.slug %></code></td>
            <td>
              <% if (dbPage) { %>
                <% if (dbPage.status === 'published') { %>
                  <span class="admin-badge admin-badge-success">Published</span>
                <% } else if (dbPage.status === 'draft') { %>
                  <span class="admin-badge admin-badge-secondary">Draft</span>
                <% } else if (dbPage.status === 'scheduled') { %>
                  <span class="admin-badge admin-badge-info">Scheduled</span>
                <% } else { %>
                  <span class="admin-badge admin-badge-secondary"><%= dbPage.status %></span>
                <% } %>
              <% } else { %>
                <span class="admin-badge admin-badge-info">Template</span>
              <% } %>
            </td>
            <td><%= dbPage && dbPage.updatedAt ? new Date(dbPage.updatedAt).toLocaleDateString() : '-' %></td>
            <td>
              <div class="actions">
                <% if (dbPage) { %>
                  <a href="<%= adminPath %>/pages/edit/<%= dbPage.id %>" class="admin-btn admin-btn-outline admin-btn-sm"><i class="fas fa-edit"></i> Edit</a>
                  <form action="<%= adminPath %>/pages/<%= dbPage.id %>/delete" method="POST" style="display:inline" data-confirm="Are you sure you want to delete this page? This cannot be undone.">
                    <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm"><i class="fas fa-trash"></i> Delete</button>
                  </form>
                <% } else { %>
                  <a href="<%= adminPath %>/pages/create" class="admin-btn admin-btn-outline admin-btn-sm"><i class="fas fa-plus"></i> Create</a>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
