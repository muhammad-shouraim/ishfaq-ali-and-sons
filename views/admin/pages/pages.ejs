<%- include('../partials/header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3>All Pages</h3>
    <a href="/admin/pages/create" class="admin-btn admin-btn-primary"><i class="fas fa-plus"></i> New Page</a>
  </div>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Slug</th>
          <th>Status</th>
          <th>Updated</th>
          <th class="actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (pages && pages.length) { %>
          <% pages.forEach(function(page) { %>
            <tr>
              <td><%= page.title %></td>
              <td><code>/<%= page.slug %></code></td>
              <td>
                <% if (page.status === 'published') { %>
                  <span class="admin-badge admin-badge-success">Published</span>
                <% } else if (page.status === 'draft') { %>
                  <span class="admin-badge admin-badge-secondary">Draft</span>
                <% } else if (page.status === 'scheduled') { %>
                  <span class="admin-badge admin-badge-info">Scheduled</span>
                <% } else { %>
                  <span class="admin-badge admin-badge-secondary"><%= page.status %></span>
                <% } %>
              </td>
              <td><%= page.updatedAt ? new Date(page.updatedAt).toLocaleDateString() : '' %></td>
              <td>
                <div class="actions">
                  <a href="/admin/pages/<%= page._id %>/edit" class="admin-btn admin-btn-outline admin-btn-sm"><i class="fas fa-edit"></i> Edit</a>
                  <a href="/admin/pages/<%= page._id %>/delete" class="admin-btn admin-btn-danger admin-btn-sm" data-confirm="Delete this page?"><i class="fas fa-trash"></i> Delete</a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="5" style="text-align:center;color:var(--admin-text-light);padding:40px;">No pages found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
