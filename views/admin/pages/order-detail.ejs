<%- include('../partials/header') %>

<div class="page-header">
  <h1 class="page-title">Order #<%= order.orderNumber %></h1>
  <div>
    <a href="<%= adminPath %>/orders" class="admin-btn">Back to Orders</a>
    <a href="<%= adminPath %>/orders/<%= order.id %>/invoice" class="admin-btn admin-btn-primary" target="_blank">Invoice</a>
  </div>
</div>

<div class="grid-3">
  <div class="admin-card">
    <div class="admin-card-header">
      <h3><i class="fas fa-info-circle"></i> Order Info</h3>
    </div>
    <div class="admin-card-body">
      <table class="info-table">
        <tr><td>Order #</td><td><strong>#<%= order.orderNumber %></strong></td></tr>
        <tr><td>Date</td><td><%= new Date(order.createdAt).toLocaleString() %></td></tr>
        <tr><td>Status</td><td>
          <% var sClass = { pending: 'admin-badge-warning', processing: 'admin-badge-info', shipped: 'admin-badge-primary', delivered: 'admin-badge-success', cancelled: 'admin-badge-danger', refunded: 'admin-badge-secondary' } %>
          <span class="admin-badge <%= sClass[order.orderStatus] || 'admin-badge-secondary' %>"><%= order.orderStatus %></span>
        </td></tr>
        <tr><td>Payment</td><td><%= order.paymentMethod || '-' %></td></tr>
        <% if (order.accountName) { %><tr><td>Account Name</td><td><%= order.accountName %></td></tr><% } %>
        <% if (order.transactionId) { %><tr><td>Transaction ID</td><td><%= order.transactionId %></td></tr><% } %>
        <tr><td>Payment Status</td><td>
          <% var pClass = { paid: 'admin-badge-success', pending: 'admin-badge-warning', failed: 'admin-badge-danger', refunded: 'admin-badge-info' } %>
          <span class="admin-badge <%= pClass[order.paymentStatus] || 'admin-badge-secondary' %>"><%= order.paymentStatus || 'pending' %></span>
        </td></tr>
      </table>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h3><i class="fas fa-user"></i> Customer</h3>
    </div>
    <div class="admin-card-body">
      <table class="info-table">
        <tr><td>Name</td><td><strong><%= order.customerName %></strong></td></tr>
        <tr><td>Email</td><td><%= order.customerEmail %></td></tr>
        <tr><td>Phone</td><td><%= order.customerPhone || '-' %></td></tr>
      </table>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h3><i class="fas fa-truck"></i> Shipping</h3>
    </div>
    <div class="admin-card-body">
      <table class="info-table">
        <tr><td>Address</td><td><%= order.shippingAddress || '-' %></td></tr>
        <tr><td>City</td><td><%= order.shippingCity || '-' %></td></tr>
        <tr><td>State</td><td><%= order.shippingState || '-' %></td></tr>
        <tr><td>Zip</td><td><%= order.shippingZip || '-' %></td></tr>
        <tr><td>Country</td><td><%= order.shippingCountry || '-' %></td></tr>
      </table>
    </div>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-header">
    <h3>Order Items</h3>
  </div>
  <div class="admin-card-body">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Qty</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% if (order.items && order.items.length > 0) { %>
          <% order.items.forEach(function(item) { %>
          <tr>
            <td><%= item.productName %></td>
            <td>Rs. <%= (item.price || 0).toLocaleString() %></td>
            <td><%= item.quantity %></td>
            <td>Rs. <%= ((item.price || 0) * item.quantity).toLocaleString() %></td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4" class="text-center">No items</td></tr>
        <% } %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" class="text-right"><strong>Subtotal</strong></td>
          <td>Rs. <%= (order.subtotal || 0).toLocaleString() %></td>
        </tr>
        <tr>
          <td colspan="3" class="text-right">Shipping</td>
          <td>Rs. <%= (order.shippingCost || 0).toLocaleString() %></td>
        </tr>
        <tr>
          <td colspan="3" class="text-right"><strong>Total</strong></td>
          <td><strong>Rs. <%= (order.total || 0).toLocaleString() %></strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<div class="grid-2">
  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Status Timeline</h3>
    </div>
    <div class="admin-card-body">
      <div class="timeline">
        <% if (order.timeline && order.timeline.length > 0) { %>
          <% order.timeline.forEach(function(entry) { %>
          <div class="timeline-item">
            <div class="timeline-marker <%= entry.status %>"></div>
            <div class="timeline-content">
              <span class="timeline-status"><%= entry.status %></span>
              <span class="timeline-date"><%= new Date(entry.date).toLocaleString() %></span>
              <% if (entry.note) { %><p class="timeline-note"><%= entry.note %></p><% } %>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <p class="text-center">No status updates yet</p>
        <% } %>
      </div>
    </div>
  </div>

  <div class="grid-2">
    <div class="admin-card">
      <div class="admin-card-header">
        <h3><i class="fas fa-edit"></i> Update Status</h3>
      </div>
      <div class="admin-card-body">
        <form action="<%= adminPath %>/orders/<%= order.id %>/status" method="POST" class="admin-form">
          <div class="form-group">
            <select name="status" class="form-input" required>
              <option value="">Select Status</option>
              <% var allStatuses = ['pending','confirmed','processing','shipped','delivered','cancelled']; %>
              <% allStatuses.forEach(function(s) { %>
                <option value="<%= s %>" <%= s === order.orderStatus || !allowedTransitions.includes(s) ? 'disabled' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <textarea name="note" class="form-input" rows="2" placeholder="Add a note (optional)"></textarea>
          </div>
          <button type="submit" class="admin-btn admin-btn-primary">Update Status</button>
        </form>
        <hr style="margin:15px 0">
        <p><strong>Current:</strong> <span class="admin-badge <%= sClass[order.orderStatus] || '' %>"><%= order.orderStatus %></span></p>
        <p><strong>Allowed transitions:</strong> <%= allowedTransitions.length ? allowedTransitions.join(', ') : 'None (final state)' %></p>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-header">
        <h3><i class="fas fa-map-marker-alt"></i> Tracking</h3>
      </div>
      <div class="admin-card-body">
        <form action="<%= adminPath %>/orders/<%= order.id %>/tracking" method="POST" class="admin-form">
          <div class="form-group">
            <label for="trackingNumber">Tracking Number</label>
            <input type="text" id="trackingNumber" name="trackingNumber" class="form-input" value="<%= order.trackingNumber || '' %>">
          </div>
          <div class="form-group">
            <label for="carrier">Carrier</label>
            <select id="carrier" name="carrier" class="form-input">
              <option value="">Select Carrier</option>
              <option value="fedex" <%= order.carrier == 'fedex' ? 'selected' : '' %>>FedEx</option>
              <option value="ups" <%= order.carrier == 'ups' ? 'selected' : '' %>>UPS</option>
              <option value="usps" <%= order.carrier == 'usps' ? 'selected' : '' %>>USPS</option>
              <option value="dhl" <%= order.carrier == 'dhl' ? 'selected' : '' %>>DHL</option>
            </select>
          </div>
          <button type="submit" class="admin-btn admin-btn-primary">Update Tracking</button>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="admin-card">
    <div class="admin-card-header">
      <h3><i class="fas fa-sticky-note"></i> Internal Notes (Staff Only)</h3>
    </div>
    <div class="admin-card-body">
      <form id="internalNotesForm" class="admin-form">
        <div class="form-group">
          <textarea name="notes" class="form-input" rows="4" placeholder="Add internal notes..."><%= order.internalNotes || '' %></textarea>
        </div>
        <button type="submit" class="admin-btn admin-btn-primary">Save Notes</button>
        <span id="notesStatus" class="text-muted" style="margin-left:10px"></span>
      </form>
    </div>
  </div>
  <div class="admin-card">
    <div class="admin-card-header">
      <h3><i class="fas fa-print"></i> Packing Slip</h3>
    </div>
    <div class="admin-card-body" style="text-align:center">
      <p>Generate a printable packing slip for this order.</p>
      <a href="<%= adminPath %>/orders/<%= order.id %>/packing-slip" class="admin-btn admin-btn-primary" target="_blank">
        <i class="fas fa-print"></i> Print Packing Slip
      </a>
      <% if (order.packingSlipPrinted) { %>
        <p class="text-muted" style="margin-top:10px"><i class="fas fa-check-circle text-success"></i> Packing slip was previously printed</p>
      <% } %>
    </div>
  </div>
</div>

<script>
document.getElementById('internalNotesForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var notes = this.querySelector('[name="notes"]').value;
  var status = document.getElementById('notesStatus');
  status.textContent = 'Saving...';
  fetch('<%= adminPath %>/orders/<%= order.id %>/notes', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ notes: notes })
  }).then(function(r) { return r.json(); }).then(function(data) {
    status.textContent = data.success ? 'Saved!' : 'Error saving';
    if (data.success) setTimeout(function() { status.textContent = ''; }, 2000);
  }).catch(function() { status.textContent = 'Error saving'; });
});
</script>

<%- include('../partials/footer') %>