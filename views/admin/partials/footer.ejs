<script src="/admin/js/admin.js"></script>
<script>
(function() {
  var flash = document.querySelector('.admin-alert');
  if (flash && typeof adminToast === 'function') {
    var msg = flash.textContent.trim();
    var type = flash.classList.contains('admin-alert-success') ? 'success' : flash.classList.contains('admin-alert-danger') ? 'error' : 'warning';
    setTimeout(function() { adminToast(msg, type); }, 100);
  }
})();
</script>
<% if (typeof useEditor !== 'undefined' && useEditor) { %>
<script>
tinymce.init({
  selector: '.rich-editor',
  height: 500,
  menubar: true,
  plugins: 'advlist autolink lists link image charmap preview anchor searchreplace visualblocks code fullscreen media table code help wordcount',
  toolbar: 'undo redo | blocks | bold italic forecolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | removeformat | help',
  content_style: 'body { font-family:Montserrat,sans-serif; font-size:14px; }'
});
</script>
<% } %>
