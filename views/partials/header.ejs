<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ' + siteName : siteName %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'ISHFAQ ALI & SONS - Premium Luxury Jewelry. Exquisite Karit and Turkish Jewelry collections. Handcrafted elegance since generations.' %>">
  <meta name="keywords" content="<%= typeof metaKeywords !== 'undefined' && metaKeywords ? metaKeywords : 'jewelry, luxury jewelry, karit, turkish jewelry, gold jewelry, ishfaq ali & sons, premium jewelry' %>">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= siteUrl %><%= currentUrl %>">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : (typeof title !== 'undefined' ? title + ' | ' + siteName : siteName) %>">
  <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : (typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'ISHFAQ ALI & SONS - Premium Luxury Jewelry') %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : (siteUrl + '/images/logo.jpeg') %>">
  <meta property="og:url" content="<%= siteUrl %><%= currentUrl %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : (typeof title !== 'undefined' ? title + ' | ' + siteName : siteName) %>">
  <meta name="twitter:description" content="<%= typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : 'ISHFAQ ALI & SONS - Premium Luxury Jewelry' %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : (siteUrl + '/images/logo.jpeg') %>">
  <link rel="icon" type="image/png" href="/images/newlogo.png">
  <link rel="shortcut icon" href="/images/newlogo.png" type="image/png">
  <link rel="apple-touch-icon" href="/images/newlogo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>