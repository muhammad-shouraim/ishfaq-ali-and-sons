<div class="announcement-bar">
  <div class="container">
    <div class="announcement-track" id="announcementTrack">
      <span class="announcement-slide"><i class="fas fa-credit-card"></i> We Accept All Cards</span>
      <span class="announcement-slide"><i class="fas fa-truck"></i> Free Delivery across Pakistan</span>
      <span class="announcement-slide"><i class="fas fa-exchange-alt"></i> Easy Return & Exchange</span>
      <span class="announcement-slide"><i class="fas fa-shield-alt"></i> 100% Secure Checkout</span>
    </div>
  </div>
</div>

<script>
(function() {
  var track = document.getElementById('announcementTrack');
  if (!track) return;
  var slides = track.querySelectorAll('.announcement-slide');
  if (slides.length < 2) return;
  var current = 0;
  var total = slides.length;

  function showSlide(index) {
    slides.forEach(function(s, i) {
      s.classList.remove('active', 'prev');
      if (i === index) s.classList.add('active');
      else if (i === (index - 1 + total) % total) s.classList.add('prev');
    });
  }
  showSlide(0);

  setInterval(function() {
    current = (current + 1) % total;
    showSlide(current);
  }, 3000);
})();
</script>